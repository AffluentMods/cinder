<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- SourceLink -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="8.0.0" />

    <!-- Avalonia -->
    <PackageVersion Include="Avalonia" Version="11.2.1" />
    <PackageVersion Include="Avalonia.Desktop" Version="11.2.1" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.2.1" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="11.2.1" />
    <PackageVersion Include="Avalonia.Diagnostics" Version="11.2.1" />
    <PackageVersion Include="Avalonia.ReactiveUI" Version="11.2.1" />
    <PackageVersion Include="FluentAvaloniaUI" Version="2.1.0" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="11.2.1" />

    <!--
      Avalonia.FreeDesktop transitively pulls Tmds.DBus.Protocol 0.20.0 which
      has a known high-severity vulnerability (GHSA-xrw6-gwf8-vvr9). We pin a
      patched version explicitly so Release builds don't fail NU1903.
    -->
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.21.3" />

    <!-- MVVM -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />

    <!-- DI / Hosting / Logging -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageVersion Include="Serilog" Version="4.2.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageVersion Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />

    <!-- Database -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageVersion Include="Dapper" Version="2.1.66" />

    <!-- Hashing / Crypto -->
    <PackageVersion Include="Blake3" Version="1.0.0" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.0" />
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.5.0" />

    <!-- Charts / Maps / Markdown -->
    <PackageVersion Include="LiveChartsCore.SkiaSharpView.Avalonia" Version="2.0.0-rc5.4" />
    <PackageVersion Include="Mapsui.Avalonia" Version="4.1.7" />
    <PackageVersion Include="Markdig" Version="0.38.0" />

    <!-- Document text extraction (PDF). Office / OpenDocument / EPUB are handled
         in-house via System.IO.Compression.ZipArchive + XML scrape — no extra dep. -->
    <PackageVersion Include="PdfPig" Version="0.1.14" />

    <!--
      DFIR parsers. Eric Zimmerman's libraries are the de-facto standard for Windows
      forensic artifacts in .NET — Cinder consumes them in-process so Phase 4 doesn't
      need a Python sidecar for the common cases. The Python parsers stay around for
      formats with no good C# equivalent (libpff PST, vol3 memory).
    -->
    <PackageVersion Include="Registry" Version="2026.5.0" />
    <PackageVersion Include="evtx" Version="1.5.2" />
    <PackageVersion Include="Lnk" Version="2026.5.3" />
    <PackageVersion Include="Prefetch" Version="2026.5.2" />
    <PackageVersion Include="JumpList" Version="2026.5.2" />

    <!-- Email / message formats — .msg + .eml + MIME. PST/OST still needs a sidecar. -->
    <PackageVersion Include="MsgReader" Version="6.0.11" />

    <!-- DiscUtils — pure-managed file-system access (NTFS / FAT / ISO9660 / ext /
         VHD / VHDX). Lets Filesystem and Carver tools read images without pytsk3. -->
    <PackageVersion Include="DiscUtils.Streams" Version="0.16.13" />
    <PackageVersion Include="DiscUtils.Core" Version="0.16.13" />
    <PackageVersion Include="DiscUtils.Ntfs" Version="0.16.13" />
    <PackageVersion Include="DiscUtils.Fat" Version="0.16.13" />
    <PackageVersion Include="DiscUtils.Iso9660" Version="0.16.13" />
    <PackageVersion Include="DiscUtils.Ext" Version="0.16.13" />
    <PackageVersion Include="DiscUtils.Vhd" Version="0.16.13" />
    <PackageVersion Include="DiscUtils.Vhdx" Version="0.16.13" />

    <!-- PCAP / PCAPNG parsing. -->
    <PackageVersion Include="SharpPcap" Version="6.3.1" />
    <PackageVersion Include="PacketDotNet" Version="1.4.8" />

    <!-- ESE / Extensible Storage Engine — for SRUM (SRUDB.dat), Windows Search,
         Mail, etc. The official Microsoft library. -->
    <PackageVersion Include="Microsoft.Database.Isam" Version="3.2.0" />

    <!-- PDF generation for court-ready reports. -->
    <PackageVersion Include="QuestPDF" Version="2026.5.0" />

    <!-- Compound document parsing (used by shell-item decoders, .doc/.ppt internals). -->
    <PackageVersion Include="OpenMcdf" Version="3.1.4" />

    <!-- HTTP -->
    <PackageVersion Include="Polly" Version="8.5.0" />
    <PackageVersion Include="Polly.Extensions.Http" Version="3.0.0" />

    <!-- Search (Lucene.NET — picked over Tantivy per docs/plan.md §13.3) -->
    <PackageVersion Include="Lucene.Net" Version="4.8.0-beta00017" />
    <PackageVersion Include="Lucene.Net.Analysis.Common" Version="4.8.0-beta00017" />
    <PackageVersion Include="Lucene.Net.QueryParser" Version="4.8.0-beta00017" />

    <!-- Multi-pattern string matching (Aho-Corasick) — backs the in-house YARA-lite scanner. -->
    <PackageVersion Include="AhoCorasick" Version="2.0.279" />

    <!-- General-purpose archive reader (TAR / GZIP / BZIP2 / ZIP / RAR / 7z) —
         primarily for Android adb backup (.ab) inside MobileTool. -->
    <PackageVersion Include="SharpCompress" Version="0.48.1" />

    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.0.0" />
    <PackageVersion Include="FluentAssertions" Version="7.0.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="Bogus" Version="35.6.1" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>
</Project>
