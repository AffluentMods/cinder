# Auto-detect text files and normalize line endings
* text=auto eol=lf

# Force LF for these
*.cs    text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.xml   text eol=lf

# Forensic test fixtures via LFS
fixtures/*.dd     filter=lfs diff=lfs merge=lfs -text
fixtures/*.E01    filter=lfs diff=lfs merge=lfs -text
fixtures/*.e01    filter=lfs diff=lfs merge=lfs -text
fixtures/*.raw    filter=lfs diff=lfs merge=lfs -text
fixtures/*.bin    filter=lfs diff=lfs merge=lfs -text
fixtures/*.aff4   filter=lfs diff=lfs merge=lfs -text
fixtures/*.vmdk   filter=lfs diff=lfs merge=lfs -text
fixtures/*.vhd    filter=lfs diff=lfs merge=lfs -text
fixtures/*.vhdx   filter=lfs diff=lfs merge=lfs -text

# Treat these as binary
*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
*.svg   binary
*.zip   binary
