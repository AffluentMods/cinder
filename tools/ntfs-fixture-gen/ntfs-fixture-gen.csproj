<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows-only by necessity: DiscUtils formats NTFS through SecurityIdentifier, which only
       exists on Windows. Not part of the solution; run by hand when the fixture must change. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Cinder.Filesystems\Cinder.Filesystems.csproj" />
  </ItemGroup>
</Project>
