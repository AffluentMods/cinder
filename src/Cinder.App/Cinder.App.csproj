<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Windows taskbar / Explorer / Alt-Tab icon. Generated by tools/icons. -->
    <ApplicationIcon>..\..\assets\branding\cinder.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>Cinder.App</RootNamespace>
    <AssemblyName>Cinder</AssemblyName>
  </PropertyGroup>

  <!-- Bundle the branded PNGs + ICO as Avalonia resources so they're addressable
       via avares:// URIs from XAML and so the published .exe contains them. -->
  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\branding\cinder.ico" Link="Assets\Branding\cinder.ico" />
    <AvaloniaResource Include="..\..\assets\branding\png\cinder-16.png"  Link="Assets\Branding\cinder-16.png" />
    <AvaloniaResource Include="..\..\assets\branding\png\cinder-32.png"  Link="Assets\Branding\cinder-32.png" />
    <AvaloniaResource Include="..\..\assets\branding\png\cinder-48.png"  Link="Assets\Branding\cinder-48.png" />
    <AvaloniaResource Include="..\..\assets\branding\png\cinder-64.png"  Link="Assets\Branding\cinder-64.png" />
    <AvaloniaResource Include="..\..\assets\branding\png\cinder-128.png" Link="Assets\Branding\cinder-128.png" />
    <AvaloniaResource Include="..\..\assets\branding\png\cinder-256.png" Link="Assets\Branding\cinder-256.png" />
    <AvaloniaResource Include="..\..\assets\branding\png\cinder-512.png" Link="Assets\Branding\cinder-512.png" />
    <AvaloniaResource Include="..\..\assets\branding\cinder-logo.svg"   Link="Assets\Branding\cinder-logo.svg" />
    <AvaloniaResource Include="..\..\assets\branding\cinder-mark.svg"   Link="Assets\Branding\cinder-mark.svg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.ReactiveUI" />
    <PackageReference Include="FluentAvaloniaUI" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Async" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Avalonia.Diagnostics" Condition="'$(Configuration)' == 'Debug'" />

    <!--
      Pin a patched Tmds.DBus.Protocol over the vulnerable 0.20.0 that
      Avalonia.FreeDesktop ships transitively. See Directory.Packages.props.
    -->
    <PackageReference Include="Tmds.DBus.Protocol" />

    <!-- Document text extraction. -->
    <PackageReference Include="PdfPig" />

    <!-- DFIR parsers (Eric Zimmerman libs) — replace the Python sidecars for the
         common Windows artifact types so Phase 4 works without venv bootstrap. -->
    <PackageReference Include="Registry" />
    <PackageReference Include="evtx" />
    <PackageReference Include="Lnk" />
    <PackageReference Include="Prefetch" />
    <PackageReference Include="JumpList" />

    <!-- Email — .msg + .eml + MIME. -->
    <PackageReference Include="MsgReader" />

    <!-- DiscUtils — filesystem parsing in pure managed code. -->
    <PackageReference Include="DiscUtils.Core" />
    <PackageReference Include="DiscUtils.Streams" />
    <PackageReference Include="DiscUtils.Ntfs" />
    <PackageReference Include="DiscUtils.Fat" />
    <PackageReference Include="DiscUtils.Iso9660" />
    <PackageReference Include="DiscUtils.Ext" />
    <PackageReference Include="DiscUtils.Vhd" />
    <PackageReference Include="DiscUtils.Vhdx" />

    <!-- Network capture parsing. -->
    <PackageReference Include="SharpPcap" />
    <PackageReference Include="PacketDotNet" />

    <!-- ESE database access (SRUM, Windows Search, …). -->
    <PackageReference Include="Microsoft.Database.Isam" />

    <!-- PDF report generation. -->
    <PackageReference Include="QuestPDF" />

    <!-- Compound documents. -->
    <PackageReference Include="OpenMcdf" />

    <!-- YARA-lite pattern matcher + archive reader. -->
    <PackageReference Include="AhoCorasick" />
    <PackageReference Include="SharpCompress" />

    <!-- Image metadata for the Map / Gallery auto-ingest pipelines. -->
    <PackageReference Include="MetadataExtractor" />

    <!-- Settings.json secret-at-rest encryption (DPAPI on Windows). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cinder.Core\Cinder.Core.csproj" />
    <ProjectReference Include="..\Cinder.Native\Cinder.Native.csproj" />
    <ProjectReference Include="..\Cinder.Sidecar\Cinder.Sidecar.csproj" />
    <ProjectReference Include="..\Cinder.Hex\Cinder.Hex.csproj" />
    <ProjectReference Include="..\Cinder.AI\Cinder.AI.csproj" />
    <ProjectReference Include="..\Cinder.Search\Cinder.Search.csproj" />
    <ProjectReference Include="..\Cinder.Reports\Cinder.Reports.csproj" />
    <ProjectReference Include="..\Cinder.Cases\Cinder.Cases.csproj" />
    <ProjectReference Include="..\Cinder.Imaging\Cinder.Imaging.csproj" />
    <ProjectReference Include="..\Cinder.Carving\Cinder.Carving.csproj" />
    <ProjectReference Include="..\Cinder.Workflow\Cinder.Workflow.csproj" />
    <ProjectReference Include="..\Cinder.Plugins\Cinder.Plugins.csproj" />
    <ProjectReference Include="..\Cinder.Native.Windows\Cinder.Native.Windows.csproj" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <ProjectReference Include="..\Cinder.Native.Linux\Cinder.Native.Linux.csproj" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
  </ItemGroup>
</Project>
