<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             x:Class="Cinder.App.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <!-- CustomAccentColor: without it FluentAvalonia falls back to its own (violet) accent,
             and every primary button in the app renders off-brand. -->
        <sty:FluentAvaloniaTheme PreferUserAccentColor="False" CustomAccentColor="#FF7A1B" />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="avares://Cinder/Themes/Cinder.Styles.axaml" />
    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Cinder/Themes/Cinder.Tokens.axaml" />
                <ResourceInclude Source="avares://Cinder/Themes/Cinder.FluentOverrides.axaml" />
                <ResourceInclude Source="avares://Cinder/Views/Tools/ToolHost.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
