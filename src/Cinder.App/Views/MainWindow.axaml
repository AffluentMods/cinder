<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cinder.App.ViewModels"
        xmlns:tools="using:Cinder.App.ViewModels.Tools"
        xmlns:views="using:Cinder.App.Views"
        x:Class="Cinder.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Cinder"
        Width="1440" Height="900"
        MinWidth="1080" MinHeight="640"
        TransparencyLevelHint="Mica,AcrylicBlur,Blur"
        Background="{DynamicResource CinderBackground0Brush}"
        Foreground="{DynamicResource CinderForegroundBrush}"
        FontFamily="{DynamicResource CinderFontFamily}"
        FontSize="{DynamicResource CinderFontSizeSm}">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+K" Command="{Binding OpenPaletteCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenFileCommand}" />
        <KeyBinding Gesture="Ctrl+F" Command="{Binding OpenFindCommand}" />
        <KeyBinding Gesture="Ctrl+G" Command="{Binding OpenGotoCommand}" />
        <KeyBinding Gesture="Ctrl+D" Command="{Binding Hex.AddBookmarkCommand}" />
        <KeyBinding Gesture="Alt+Left" Command="{Binding Hex.NavigateBackCommand}" />
        <KeyBinding Gesture="Alt+Right" Command="{Binding Hex.NavigateForwardCommand}" />
        <KeyBinding Gesture="Ctrl+C" Command="{Binding Hex.CopySelectionAsHexCommand}" />
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}" />
        <KeyBinding Gesture="F1" Command="{Binding OpenHelpCommand}" />
    </Window.KeyBindings>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ============================ TITLE BAR ============================ -->
        <Border Grid.Row="0"
                Background="#CC0B0C0F"
                BorderBrush="{DynamicResource CinderBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,12">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">

                <!-- Brand: ember glyph + wordmark -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="64" Height="64">
                            <Path Data="M32 4 C 22 18, 16 26, 16 38 C 16 50, 24 60, 32 60 C 40 60, 48 50, 48 38 C 48 30, 42 26, 38 22 C 36 28, 30 28, 30 22 C 30 16, 36 12, 32 4 Z"
                                  Fill="{DynamicResource CinderAccentBrush}" />
                            <Ellipse Canvas.Left="26" Canvas.Top="38" Width="12" Height="12"
                                     Fill="{DynamicResource CinderAccentHoverBrush}" Opacity="0.85" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="cinder"
                               FontSize="{DynamicResource CinderFontSizeLg}"
                               FontWeight="600"
                               LetterSpacing="-0.4"
                               Foreground="{DynamicResource CinderForegroundBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Vertical rule -->
                <Border Grid.Column="1" Width="1" Margin="16,4"
                        Background="{DynamicResource CinderBorderBrush}" />

                <!-- Active case + active evidence -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <!-- CASE: when no case loaded, show single "NO CASE" chip; otherwise show CASE label + name. -->
                    <StackPanel Orientation="Horizontal" Spacing="6"
                                IsVisible="{Binding ActiveCaseName, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="CASE" Classes="section" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ActiveCaseName}"
                                   Foreground="{DynamicResource CinderForegroundBrush}"
                                   FontWeight="500" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="NO CASE" Classes="section" VerticalAlignment="Center"
                               Foreground="{DynamicResource CinderForegroundDisabledBrush}"
                               IsVisible="{Binding ActiveCaseName, Converter={x:Static ObjectConverters.IsNull}}" />
                    <Border Width="1" Height="14" Background="{DynamicResource CinderBorderBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="EVIDENCE" Classes="section" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Hex.Buffer.DisplayName, FallbackValue='none'}"
                                   Classes="mono"
                                   Foreground="{DynamicResource CinderForegroundMutedBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- WriteBlock chip -->
                <Border Grid.Column="3" CornerRadius="4" Padding="8,4"
                        Background="{DynamicResource CinderSurface3Brush}"
                        BorderBrush="{DynamicResource CinderBorderBrush}" BorderThickness="1"
                        VerticalAlignment="Center" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Classes="status-dot warn" VerticalAlignment="Center" />
                        <TextBlock Text="WriteBlock OFF"
                                   FontSize="{DynamicResource CinderFontSizeXs}"
                                   FontWeight="500"
                                   Foreground="{DynamicResource CinderForegroundMutedBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Pre-alpha tag -->
                <Border Grid.Column="4" CornerRadius="3" Padding="6,3"
                        Background="Transparent"
                        BorderBrush="{DynamicResource CinderAccentDimBrush}" BorderThickness="1"
                        VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="PRE-ALPHA" Classes="section"
                               Foreground="{DynamicResource CinderAccentBrush}" />
                </Border>

                <!-- Command palette trigger -->
                <Button Grid.Column="5"
                        Command="{Binding OpenPaletteCommand}"
                        Background="{DynamicResource CinderSurface3Brush}"
                        BorderBrush="{DynamicResource CinderBorderBrush}"
                        BorderThickness="1"
                        Padding="10,5">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Search commands"
                                   FontSize="{DynamicResource CinderFontSizeXs}"
                                   Foreground="{DynamicResource CinderForegroundMutedBrush}"
                                   VerticalAlignment="Center" />
                        <Border Classes="kbd">
                            <TextBlock Text="Ctrl+K" Classes="mono"
                                       FontSize="10"
                                       Foreground="{DynamicResource CinderForegroundDisabledBrush}" />
                        </Border>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ============================ CASE TABS ============================ -->
        <!-- Shown only when at least one case is open. Lets the user juggle multiple
             cases at once, like browser tabs for investigations. -->
        <Border Grid.Row="1"
                Background="{DynamicResource CinderSurface1Brush}"
                BorderBrush="{DynamicResource CinderBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,0"
                IsVisible="{Binding OpenCases.Count}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <ItemsControl ItemsSource="{Binding OpenCases}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:CaseSession">
                                <Border CornerRadius="6,6,0,0"
                                        BorderBrush="Transparent"
                                        BorderThickness="0,0,0,2"
                                        Margin="0,6,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <!-- Tab itself — clicking switches active case -->
                                        <Button Background="Transparent" BorderThickness="0"
                                                Padding="14,8"
                                                CornerRadius="6,6,0,0"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectCaseCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="📁"
                                                           FontSize="{DynamicResource CinderFontSizeSm}"
                                                           Foreground="{DynamicResource CinderAccentBrush}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="500"
                                                           Foreground="{DynamicResource CinderForegroundBrush}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <!-- Close X -->
                                        <Button Background="Transparent" BorderThickness="0"
                                                Padding="6,4"
                                                Foreground="{DynamicResource CinderForegroundMutedBrush}"
                                                Content="×"
                                                FontSize="{DynamicResource CinderFontSizeMd}"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CloseCaseCommand}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- + tab — create a new case -->
                    <Button Background="Transparent" BorderThickness="0"
                            Padding="12,8"
                            Margin="6,6,0,0"
                            Foreground="{DynamicResource CinderForegroundMutedBrush}"
                            ToolTip.Tip="Create a new case"
                            Command="{Binding CreateCaseCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="+"
                                       FontFamily="{DynamicResource CinderFontFamilyMono}"
                                       FontSize="{DynamicResource CinderFontSizeMd}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="New case"
                                       FontSize="{DynamicResource CinderFontSizeXs}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============================ BODY ============================ -->
        <Grid Grid.Row="2" ColumnDefinitions="240,4,*,4,300">

            <!-- ===== Left activity rail ===== -->
            <Border Grid.Column="0" Background="{DynamicResource CinderSurface1Brush}"
                    BorderBrush="{DynamicResource CinderBorderBrush}" BorderThickness="0,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Workspace.Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="tools:ToolSection">
                                <StackPanel Margin="0,8,0,8">
                                    <StackPanel Margin="14,12,14,2">
                                        <TextBlock Text="{Binding Title}" Classes="section" />
                                        <Border Classes="section-rule" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Tools}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="tools:ToolViewModel">
                                                <Button Classes="rail"
                                                        Classes.selected="{Binding IsSelected}"
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Workspace.SelectCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Grid ColumnDefinitions="24,*,Auto">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Icon}"
                                                                   FontFamily="{DynamicResource CinderFontFamilyMono}"
                                                                   FontSize="{DynamicResource CinderFontSizeSm}"
                                                                   Foreground="{DynamicResource CinderAccentBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Title}"
                                                                   Foreground="{DynamicResource CinderForegroundBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Phase}"
                                                                   FontFamily="{DynamicResource CinderFontFamilyMono}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource CinderForegroundDisabledBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,4,0"
                                                                   IsVisible="{Binding Phase, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" Background="{DynamicResource CinderBorderBrush}" />

            <!-- ===== Center: tool content ===== -->
            <Border Grid.Column="2" Background="{DynamicResource CinderBackground0Brush}">
                <Grid RowDefinitions="Auto,*">
                    <!-- Tool header strip -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource CinderSurface2Brush}"
                            BorderBrush="{DynamicResource CinderBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="24,16"
                            IsVisible="{Binding Workspace.SelectedTool, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="6"
                                    Background="{DynamicResource CinderSurface3Brush}"
                                    BorderBrush="{DynamicResource CinderBorderBrush}" BorderThickness="1"
                                    Margin="0,0,16,0">
                                <TextBlock Text="{Binding Workspace.SelectedTool.Icon}"
                                           FontFamily="{DynamicResource CinderFontFamilyMono}"
                                           FontSize="{DynamicResource CinderFontSizeLg}"
                                           Foreground="{DynamicResource CinderAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <TextBlock Text="{Binding Workspace.SelectedTool.Title}"
                                           FontWeight="600"
                                           FontSize="{DynamicResource CinderFontSize2xl}"
                                           LetterSpacing="-0.5"
                                           Foreground="{DynamicResource CinderForegroundBrush}" />
                                <TextBlock Text="{Binding Workspace.SelectedTool.Subtitle}"
                                           FontSize="{DynamicResource CinderFontSizeSm}"
                                           Foreground="{DynamicResource CinderForegroundMutedBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <!-- Contextual help: opens an "About this tool" flyout. -->
                            <Button Grid.Column="2"
                                    Width="36" Height="36"
                                    Padding="0"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource CinderSurface3Brush}"
                                    BorderBrush="{DynamicResource CinderBorderBrush}" BorderThickness="1"
                                    Command="{Binding OpenHelpCommand}"
                                    ToolTip.Tip="About this tool — what it is, when to use it, how">
                                <TextBlock Text="?"
                                           FontFamily="{DynamicResource CinderFontFamilyMono}"
                                           FontSize="{DynamicResource CinderFontSizeMd}"
                                           FontWeight="600"
                                           Foreground="{DynamicResource CinderAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </Grid>
                    </Border>

                    <ContentControl Grid.Row="1"
                                    Content="{Binding Workspace.SelectedTool}"
                                    ContentTemplate="{StaticResource ToolContentTemplate}" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Background="{DynamicResource CinderBorderBrush}" />

            <!-- ===== Right: properties pane ===== -->
            <Border Grid.Column="4" Background="{DynamicResource CinderSurface1Brush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14" Spacing="18">

                        <StackPanel Spacing="2">
                            <TextBlock Text="PROPERTIES" Classes="section" />
                            <Border Classes="section-rule" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="OFFSET" Classes="section" />
                            <Border Classes="section-rule" Margin="0,0,0,4" />
                            <SelectableTextBlock Classes="mono"
                                                 FontSize="{DynamicResource CinderFontSizeMd}">
                                <Run Text="{Binding Hex.CaretOffsetHex}"
                                     Foreground="{DynamicResource CinderForegroundBrush}" />
                                <Run Text="  " />
                                <Run Text="{Binding Hex.CaretOffsetDec}"
                                     Foreground="{DynamicResource CinderForegroundMutedBrush}" />
                            </SelectableTextBlock>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="BYTE AT CARET" Classes="section" />
                            <Border Classes="section-rule" Margin="0,0,0,4" />
                            <SelectableTextBlock Classes="mono"
                                                 FontSize="{DynamicResource CinderFontSizeSm}"
                                                 TextWrapping="Wrap">
                                <Run Text="{Binding Hex.CaretByteHex}"
                                     Foreground="{DynamicResource CinderForegroundBrush}" />
                                <Run Text=" · " Foreground="{DynamicResource CinderForegroundDisabledBrush}" />
                                <Run Text="{Binding Hex.CaretByteDec}"
                                     Foreground="{DynamicResource CinderForegroundBrush}" />
                                <Run Text=" · " Foreground="{DynamicResource CinderForegroundDisabledBrush}" />
                                <Run Text="{Binding Hex.CaretByteAscii}"
                                     Foreground="{DynamicResource CinderForegroundBrush}" />
                                <Run Text=" · " Foreground="{DynamicResource CinderForegroundDisabledBrush}" />
                                <Run Text="{Binding Hex.CaretByteBinary}"
                                     Foreground="{DynamicResource CinderForegroundBrush}" />
                            </SelectableTextBlock>
                            <TextBlock Text="hex · dec · ascii · binary"
                                       FontSize="10"
                                       Foreground="{DynamicResource CinderForegroundDisabledBrush}" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="INSPECTOR" Classes="section" />
                            <Border Classes="section-rule" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Hex.InspectorRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:InspectorRow">
                                        <Grid ColumnDefinitions="92,*" Margin="0,3,0,3">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Label}"
                                                       FontSize="{DynamicResource CinderFontSizeXs}"
                                                       FontWeight="450"
                                                       Foreground="{DynamicResource CinderForegroundMutedBrush}" />
                                            <SelectableTextBlock Grid.Column="1"
                                                                 Text="{Binding Value}"
                                                                 Classes="mono"
                                                                 FontSize="{DynamicResource CinderFontSizeSm}"
                                                                 FontWeight="600"
                                                                 Foreground="{DynamicResource CinderForegroundBrush}"
                                                                 TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="6" IsVisible="{Binding Hex.Bookmarks.Count}">
                            <TextBlock Text="BOOKMARKS · CTRL+D" Classes="section" />
                            <Border Classes="section-rule" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Hex.Bookmarks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Background="Transparent"
                                                BorderThickness="0"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Padding="2,3"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Hex.GotoBookmarkCommand}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding Label}"
                                                       Classes="mono"
                                                       FontSize="{DynamicResource CinderFontSizeXs}"
                                                       Foreground="{DynamicResource CinderForegroundBrush}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ============================ STATUS BAR ============================ -->
        <Border Grid.Row="3"
                Background="{DynamicResource CinderSurface0Brush}"
                BorderBrush="{DynamicResource CinderBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,8">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Ellipse Classes="status-dot ok" />
                    <TextBlock Text="{Binding ActivityHeadline}"
                               Foreground="{DynamicResource CinderForegroundMutedBrush}"
                               FontSize="{DynamicResource CinderFontSizeXs}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Border Grid.Column="1" Padding="8,3" CornerRadius="3"
                        Background="{DynamicResource CinderSurface3Brush}"
                        BorderBrush="{DynamicResource CinderAccentDimBrush}" BorderThickness="1"
                        Margin="0,0,12,0"
                        IsVisible="{Binding Hex.HasSelection}">
                    <TextBlock Text="{Binding Hex.SelectionSummary}"
                               Classes="mono"
                               Foreground="{DynamicResource CinderAccentBrush}"
                               FontSize="{DynamicResource CinderFontSizeXs}" />
                </Border>

                <Border Grid.Column="2" Width="1" Height="14" Margin="0,0,12,0"
                        Background="{DynamicResource CinderBorderBrush}" />

                <TextBlock Grid.Column="3"
                           Text="{Binding Hex.CaretOffsetHex, FallbackValue=''}"
                           Classes="mono"
                           FontSize="{DynamicResource CinderFontSizeXs}"
                           Foreground="{DynamicResource CinderForegroundMutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           IsVisible="{Binding Hex.Buffer, Converter={x:Static ObjectConverters.IsNotNull}}" />

                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border Classes="kbd"><TextBlock Text="F1" Classes="mono" FontSize="10"
                                                     Foreground="{DynamicResource CinderForegroundDisabledBrush}" /></Border>
                    <TextBlock Text="help"
                               FontSize="{DynamicResource CinderFontSizeXs}"
                               Foreground="{DynamicResource CinderForegroundDisabledBrush}" />
                    <Border Classes="kbd" Margin="6,0,0,0"><TextBlock Text="Ctrl+K" Classes="mono" FontSize="10"
                                                                     Foreground="{DynamicResource CinderForegroundDisabledBrush}" /></Border>
                    <TextBlock Text="commands"
                               FontSize="{DynamicResource CinderFontSizeXs}"
                               Foreground="{DynamicResource CinderForegroundDisabledBrush}" />
                    <Border Classes="kbd" Margin="6,0,0,0"><TextBlock Text="Ctrl+O" Classes="mono" FontSize="10"
                                                                     Foreground="{DynamicResource CinderForegroundDisabledBrush}" /></Border>
                    <TextBlock Text="open"
                               FontSize="{DynamicResource CinderFontSizeXs}"
                               Foreground="{DynamicResource CinderForegroundDisabledBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <views:CommandPaletteView Grid.Row="0"
                                  Grid.RowSpan="4"
                                  DataContext="{Binding Palette}"
                                  IsVisible="{Binding IsOpen}" />

        <!-- Contextual help flyout. Bound directly to the MainWindowViewModel. -->
        <views:HelpFlyoutView Grid.Row="0"
                              Grid.RowSpan="4"
                              IsVisible="{Binding IsHelpOpen}" />
    </Grid>
</Window>
