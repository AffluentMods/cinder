<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cinder.App.ViewModels"
        xmlns:views="using:Cinder.App.Views"
        x:Class="Cinder.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Cinder"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        Background="{DynamicResource CinderBackground0Brush}"
        Foreground="{DynamicResource CinderForegroundBrush}"
        FontFamily="{DynamicResource CinderFontFamily}"
        FontSize="{DynamicResource CinderFontSizeSm}">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+K" Command="{Binding OpenPaletteCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenFileCommand}" />
        <KeyBinding Gesture="Ctrl+F" Command="{Binding OpenFindCommand}" />
        <KeyBinding Gesture="Ctrl+G" Command="{Binding OpenGotoCommand}" />
        <KeyBinding Gesture="Ctrl+D" Command="{Binding Hex.AddBookmarkCommand}" />
        <KeyBinding Gesture="Alt+Left" Command="{Binding Hex.NavigateBackCommand}" />
        <KeyBinding Gesture="Alt+Right" Command="{Binding Hex.NavigateForwardCommand}" />
        <KeyBinding Gesture="Ctrl+C" Command="{Binding Hex.CopySelectionAsHexCommand}" />
        <KeyBinding Gesture="Ctrl+Comma" Command="{Binding OpenSettingsCommand}" />
    </Window.KeyBindings>

    <Grid RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0"
                Background="{DynamicResource CinderBackground1Brush}"
                BorderBrush="{DynamicResource CinderBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0"
                           Text="🔥 Cinder"
                           FontWeight="600"
                           FontSize="{DynamicResource CinderFontSizeMd}"
                           Foreground="{DynamicResource CinderAccentBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding HeaderSubtitle}"
                           Foreground="{DynamicResource CinderForegroundMutedBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        Command="{Binding OpenPaletteCommand}"
                        Content="Ctrl+K  Search commands"
                        Foreground="{DynamicResource CinderForegroundMutedBrush}"
                        Background="{DynamicResource CinderBackground2Brush}"
                        BorderBrush="{DynamicResource CinderBorderBrush}"
                        Padding="10,4" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="240,4,*,4,300">
            <Border Grid.Column="0" Background="{DynamicResource CinderBackground1Brush}">
                <DockPanel Margin="14">
                    <TextBlock DockPanel.Dock="Top"
                               Text="CASE"
                               FontWeight="600"
                               FontSize="{DynamicResource CinderFontSizeXs}"
                               Foreground="{DynamicResource CinderForegroundMutedBrush}"
                               Margin="0,0,0,12" />
                    <StackPanel DockPanel.Dock="Top" Spacing="10"
                                IsVisible="{Binding ActiveCaseName, Converter={x:Static ObjectConverters.IsNull}}">
                        <TextBlock Text="No case open"
                                   Foreground="{DynamicResource CinderForegroundDisabledBrush}" />
                        <Button Classes="accent"
                                Content="Open file…"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Command="{Binding OpenFileCommand}" />
                        <Button Content="Create case…"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Command="{Binding CreateCaseCommand}"
                                ToolTip.Tip="Create a Cinder case file (.cinder). Multi-case branching ships in Phase 8." />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding CaseTreeItems}"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource CinderForegroundBrush}"
                             IsVisible="{Binding ActiveCaseName, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Background="{DynamicResource CinderBorderBrush}" />

            <TabControl Grid.Column="2"
                        ItemsSource="{Binding Tabs}"
                        SelectedItem="{Binding SelectedTab}"
                        Background="{DynamicResource CinderBackground0Brush}"
                        Padding="0">
                <TabControl.ItemTemplate>
                    <DataTemplate DataType="vm:TabItemViewModel">
                        <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate DataType="vm:TabItemViewModel">
                        <Panel>
                            <Grid IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='hex'}"
                                  RowDefinitions="Auto,*">
                                <Border Grid.Row="0"
                                        Background="{DynamicResource CinderBackground1Brush}"
                                        BorderBrush="{DynamicResource CinderBorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="6,3">
                                    <ItemsControl ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenBuffers}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:HexViewModel">
                                                <Border Padding="0" CornerRadius="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Button Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="10,4"
                                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetActiveBufferCommand}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Text="{Binding Buffer.DisplayName, FallbackValue='(empty)'}"
                                                                       Foreground="{DynamicResource CinderForegroundBrush}" />
                                                        </Button>
                                                        <Button Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="4,0"
                                                                Foreground="{DynamicResource CinderForegroundMutedBrush}"
                                                                Content="×"
                                                                ToolTip.Tip="Close tab"
                                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CloseBufferCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <ContentControl Grid.Row="1"
                                                Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Hex}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate DataType="vm:HexViewModel">
                                            <views:HexView />
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </Grid>
                            <TextBlock IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='gallery'}"
                                       Text="Image gallery — Phase 4 deliverable. Drop a folder to scan."
                                       Foreground="{DynamicResource CinderForegroundMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='timeline'}"
                                       Text="Super-timeline — Phase 6 deliverable."
                                       Foreground="{DynamicResource CinderForegroundMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='reports'}"
                                       Text="Report builder — Phase 8 deliverable."
                                       Foreground="{DynamicResource CinderForegroundMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Panel>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <GridSplitter Grid.Column="3" Background="{DynamicResource CinderBorderBrush}" />

            <Border Grid.Column="4" Background="{DynamicResource CinderBackground1Brush}">
                <DockPanel Margin="14">
                    <TextBlock DockPanel.Dock="Top"
                               Text="PROPERTIES"
                               FontWeight="600"
                               FontSize="{DynamicResource CinderFontSizeXs}"
                               Foreground="{DynamicResource CinderForegroundMutedBrush}"
                               Margin="0,0,0,12" />
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Offset"
                                       FontSize="{DynamicResource CinderFontSizeXs}"
                                       Foreground="{DynamicResource CinderForegroundDisabledBrush}" />
                            <SelectableTextBlock FontFamily="{DynamicResource CinderFontFamilyMono}"
                                                 FontSize="{DynamicResource CinderFontSizeMd}">
                                <Run Text="{Binding Hex.CaretOffsetHex}"
                                     Foreground="{DynamicResource CinderForegroundBrush}" />
                                <Run Text="  " />
                                <Run Text="{Binding Hex.CaretOffsetDec}"
                                     Foreground="{DynamicResource CinderForegroundMutedBrush}" />
                            </SelectableTextBlock>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Byte at caret"
                                       FontSize="{DynamicResource CinderFontSizeXs}"
                                       Foreground="{DynamicResource CinderForegroundDisabledBrush}" />
                            <SelectableTextBlock FontFamily="{DynamicResource CinderFontFamilyMono}"
                                                 FontSize="{DynamicResource CinderFontSizeSm}"
                                                 TextWrapping="Wrap">
                                <Run Text="{Binding Hex.CaretByteHex}"
                                     Foreground="{DynamicResource CinderForegroundBrush}" />
                                <Run Text=" · " Foreground="{DynamicResource CinderForegroundDisabledBrush}" />
                                <Run Text="{Binding Hex.CaretByteDec}"
                                     Foreground="{DynamicResource CinderForegroundBrush}" />
                                <Run Text=" · " Foreground="{DynamicResource CinderForegroundDisabledBrush}" />
                                <Run Text="{Binding Hex.CaretByteAscii}"
                                     Foreground="{DynamicResource CinderForegroundBrush}" />
                                <Run Text=" · " Foreground="{DynamicResource CinderForegroundDisabledBrush}" />
                                <Run Text="{Binding Hex.CaretByteBinary}"
                                     Foreground="{DynamicResource CinderForegroundBrush}" />
                            </SelectableTextBlock>
                            <TextBlock Text="hex · dec · ascii · binary"
                                       FontSize="{DynamicResource CinderFontSizeXs}"
                                       Foreground="{DynamicResource CinderForegroundDisabledBrush}" />
                        </StackPanel>
                        <StackPanel Spacing="4"
                                    IsVisible="{Binding Hex.DetectedFormat, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Text="Detected format"
                                       FontSize="{DynamicResource CinderFontSizeXs}"
                                       Foreground="{DynamicResource CinderForegroundDisabledBrush}" />
                            <TextBlock Text="{Binding Hex.DetectedFormat}"
                                       Foreground="{DynamicResource CinderForegroundBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="4"
                                    IsVisible="{Binding Hex.QuickHashSha256, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Text="Quick hash (first 4 MiB) — click to copy"
                                       FontSize="{DynamicResource CinderFontSizeXs}"
                                       Foreground="{DynamicResource CinderForegroundDisabledBrush}" />
                            <Button Background="Transparent"
                                    BorderThickness="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Padding="0"
                                    Command="{Binding Hex.CopyQuickHashCommand}"
                                    ToolTip.Tip="Click to copy full SHA-256 to clipboard">
                                <TextBlock Text="{Binding Hex.QuickHashSha256}"
                                           FontFamily="{DynamicResource CinderFontFamilyMono}"
                                           FontSize="{DynamicResource CinderFontSizeXs}"
                                           Foreground="{DynamicResource CinderForegroundMutedBrush}" />
                            </Button>
                        </StackPanel>

                        <!-- Inspector: caret bytes interpreted as common types -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Inspector"
                                       FontSize="{DynamicResource CinderFontSizeXs}"
                                       Foreground="{DynamicResource CinderForegroundDisabledBrush}" />
                            <ItemsControl ItemsSource="{Binding Hex.InspectorRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:InspectorRow">
                                        <Grid ColumnDefinitions="92,*" Margin="0,2,0,2">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Label}"
                                                       FontSize="{DynamicResource CinderFontSizeXs}"
                                                       Foreground="{DynamicResource CinderForegroundMutedBrush}" />
                                            <SelectableTextBlock Grid.Column="1"
                                                                 Text="{Binding Value}"
                                                                 FontFamily="{DynamicResource CinderFontFamilyMono}"
                                                                 FontSize="{DynamicResource CinderFontSizeXs}"
                                                                 Foreground="{DynamicResource CinderForegroundBrush}"
                                                                 TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Bookmarks list -->
                        <StackPanel Spacing="6"
                                    IsVisible="{Binding Hex.Bookmarks.Count}">
                            <TextBlock Text="Bookmarks (Ctrl+D)"
                                       FontSize="{DynamicResource CinderFontSizeXs}"
                                       Foreground="{DynamicResource CinderForegroundDisabledBrush}" />
                            <ItemsControl ItemsSource="{Binding Hex.Bookmarks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Background="Transparent"
                                                BorderThickness="0"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Padding="2,3"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Hex.GotoBookmarkCommand}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding Label}"
                                                       FontFamily="{DynamicResource CinderFontFamilyMono}"
                                                       FontSize="{DynamicResource CinderFontSizeXs}"
                                                       Foreground="{DynamicResource CinderForegroundBrush}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource CinderBackground1Brush}"
                BorderBrush="{DynamicResource CinderBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding ActivityHeadline}"
                           Foreground="{DynamicResource CinderForegroundMutedBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Hex.SelectionSummary}"
                           Foreground="{DynamicResource CinderAccentBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"
                           IsVisible="{Binding Hex.HasSelection}" />
                <TextBlock Grid.Column="2"
                           Text="{Binding StatusBar}"
                           Foreground="{DynamicResource CinderForegroundMutedBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <views:CommandPaletteView Grid.Row="0"
                                  Grid.RowSpan="3"
                                  DataContext="{Binding Palette}"
                                  IsVisible="{Binding IsOpen}" />
    </Grid>
</Window>
