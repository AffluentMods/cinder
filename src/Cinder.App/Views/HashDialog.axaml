<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cinder.App.ViewModels"
        x:Class="Cinder.App.Views.HashDialog"
        x:DataType="vm:HashDialogViewModel"
        Title="Hash a file"
        Width="700" Height="440" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CinderSurface1Brush}"
        Foreground="{DynamicResource CinderForegroundBrush}"
        FontFamily="{DynamicResource CinderFontFamily}"
        FontSize="{DynamicResource CinderFontSizeBase}">
    <!-- Opened from the palette command "Hash a file…". Digests are of the file's own bytes;
         the view-model explains why, and says so again here when the file is a container. -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="20,12" Background="{DynamicResource CinderSurface0Brush}"
                BorderBrush="{DynamicResource CinderBorderBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding StatusLine}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,16,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="tb" Height="30" Padding="16,0" Content="Cancel hashing"
                            Command="{Binding HashCancelCommand}" IsVisible="{Binding IsComputing}" />
                    <Button Classes="tb" Height="30" Padding="16,0" Content="Close" Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Margin="24,20" Spacing="14">
            <TextBlock Classes="muted" FontSize="12" LineHeight="17" TextWrapping="Wrap"
                       Text="MD5, SHA-1, SHA-256 and BLAKE3 of one file, read once. The digests are of the file exactly as it is stored on disk. With a case open, the result is added to its custody log." />

            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBox x:Name="PathBox" Text="{Binding Path}" Watermark="Path to a file — or drop one here"
                         ToolTip.Tip="{Binding Path}"
                         FontFamily="{DynamicResource CinderFontFamilyMono}" IsEnabled="{Binding !IsComputing}" />
                <Button Grid.Column="1" Classes="tb" Height="30" Padding="14,0" Margin="8,0,0,0" Content="Browse…"
                        Click="OnBrowseClick" IsEnabled="{Binding !IsComputing}" />
                <Button Grid.Column="2" Classes="accent" Height="30" Padding="18,0" Margin="8,0,0,0" Content="Hash"
                        Command="{Binding HashCommand}" IsDefault="True" />
            </Grid>

            <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" Height="4"
                         IsVisible="{Binding IsComputing}" />

            <StackPanel Spacing="9">
                <Grid ColumnDefinitions="90,*">
                    <TextBlock Text="MD5" Classes="muted" />
                    <SelectableTextBlock Grid.Column="1" Text="{Binding Md5}" Classes="mono" TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="90,*">
                    <TextBlock Text="SHA-1" Classes="muted" />
                    <SelectableTextBlock Grid.Column="1" Text="{Binding Sha1}" Classes="mono" TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="90,*">
                    <TextBlock Text="SHA-256" Classes="muted" />
                    <SelectableTextBlock Grid.Column="1" Text="{Binding Sha256}" Classes="mono" TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="90,*">
                    <TextBlock Text="BLAKE3" Classes="muted" />
                    <SelectableTextBlock Grid.Column="1" Text="{Binding Blake3}" Classes="mono" TextWrapping="Wrap" />
                </Grid>
            </StackPanel>

            <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" FontSize="12" LineHeight="17"
                       Foreground="{DynamicResource CinderWarnBrush}" />
            <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap"
                       Foreground="{DynamicResource CinderDangerBrush}" />
        </StackPanel>
    </DockPanel>
</Window>
