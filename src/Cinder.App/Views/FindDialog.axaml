<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cinder.App.ViewModels"
        xmlns:hx="using:Cinder.Hex"
        x:Class="Cinder.App.Views.FindDialog"
        x:DataType="vm:FindDialogViewModel"
        Title="Cinder · Find"
        Width="640" Height="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CinderBackground1Brush}"
        Foreground="{DynamicResource CinderForegroundBrush}">

    <Border BorderBrush="{DynamicResource CinderBorderStrongBrush}" BorderThickness="1" CornerRadius="6">
        <Grid Margin="18" RowDefinitions="Auto,Auto,Auto,*,Auto">

            <TextBlock Grid.Row="0"
                       Text="FIND IN BUFFER"
                       FontWeight="600"
                       FontSize="{DynamicResource CinderFontSizeXs}"
                       Foreground="{DynamicResource CinderForegroundMutedBrush}" />

            <Grid Grid.Row="1" Margin="0,10,0,8" ColumnDefinitions="140,*,Auto">
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding AvailableModes}"
                          SelectedItem="{Binding Mode}"
                          Margin="0,0,8,0" />
                <TextBox Grid.Column="1"
                         Name="QueryInput"
                         Text="{Binding Query, Mode=TwoWay}"
                         Watermark="Pattern (mode-specific)"
                         FontFamily="{DynamicResource CinderFontFamilyMono}"
                         FontSize="{DynamicResource CinderFontSizeMd}">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Return" Command="{Binding RunCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="2"
                        Margin="8,0,0,0"
                        Classes="accent"
                        Content="Find"
                        Command="{Binding RunCommand}"
                        IsEnabled="{Binding !IsSearching}" />
            </Grid>

            <CheckBox Grid.Row="2"
                      IsChecked="{Binding CaseSensitive}"
                      Content="Case sensitive"
                      Foreground="{DynamicResource CinderForegroundMutedBrush}" />

            <ListBox Grid.Row="3"
                     Margin="0,12,0,0"
                     ItemsSource="{Binding Hex.SearchResults}"
                     SelectedItem="{Binding Hex.SelectedSearchResult}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="hx:HexSearchHit">
                        <StackPanel Orientation="Horizontal" Spacing="14" Margin="2,0">
                            <TextBlock Text="{Binding Offset, StringFormat='0x{0:X12}'}"
                                       FontFamily="{DynamicResource CinderFontFamilyMono}"
                                       Foreground="{DynamicResource CinderAccentBrush}" />
                            <TextBlock Text="{Binding Length, StringFormat='{}{0} bytes'}"
                                       Foreground="{DynamicResource CinderForegroundMutedBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="4"
                       Margin="0,10,0,0"
                       Text="{Binding StatusLine}"
                       Foreground="{DynamicResource CinderForegroundMutedBrush}"
                       FontSize="{DynamicResource CinderFontSizeXs}" />
        </Grid>
    </Border>
</Window>
