<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cinder.App.ViewModels"
        x:Class="Cinder.App.Views.GotoDialog"
        x:DataType="vm:HexViewModel"
        Title="Go to offset"
        Width="420" Height="160"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="BorderOnly"
        FontFamily="{DynamicResource CinderFontFamily}"
        FontSize="{DynamicResource CinderFontSizeBase}"
        Background="{DynamicResource CinderSurface1Brush}"
        Foreground="{DynamicResource CinderForegroundBrush}">

    <Border BorderBrush="{DynamicResource CinderBorderStrongBrush}" BorderThickness="1" CornerRadius="6">
        <DockPanel Margin="18">
            <TextBlock DockPanel.Dock="Top"
                       Text="GO TO OFFSET"
                       FontWeight="600"
                       FontSize="{DynamicResource CinderFontSizeXs}"
                       Foreground="{DynamicResource CinderForegroundMutedBrush}" />
            <TextBlock DockPanel.Dock="Top"
                       Text="Type a position in the file, in decimal or in hex with 0x in front. Enter jumps there; Esc closes."
                       Margin="0,4,0,12"
                       FontSize="{DynamicResource CinderFontSizeXs}"
                       Foreground="{DynamicResource CinderForegroundDisabledBrush}"
                       TextWrapping="Wrap" />
            <TextBox Name="GotoInput"
                     Watermark="0x1F400  or  128000"
                     FontFamily="{DynamicResource CinderFontFamilyMono}"
                     FontSize="{DynamicResource CinderFontSizeMd}">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Return" Command="{Binding GotoOffsetCommand}" CommandParameter="{Binding ElementName=GotoInput, Path=Text}" />
                </TextBox.KeyBindings>
            </TextBox>
        </DockPanel>
    </Border>
</Window>
