<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cinder.App.ViewModels"
             xmlns:hx="using:Cinder.Hex"
             xmlns:c="using:Cinder.App.Controls"
             x:Class="Cinder.App.Views.HexView"
             x:DataType="vm:HexViewModel">
    <Grid RowDefinitions="Auto,*">

        <!-- ============================ Toolbar ============================ -->
        <Border Grid.Row="0" Height="44" Padding="14,0,10,0"
                BorderBrush="{DynamicResource CinderBorderBrush}" BorderThickness="0,0,0,1"
                IsVisible="{Binding Buffer, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <!-- The find field never drops below a width you can type a query in. -->
                    <ColumnDefinition Width="*" MinWidth="300" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- What the file is: type, size, digest. One row of a wrap panel with the overflow
                     clipped, so when the window is narrow a chip that does not fit disappears
                     whole instead of being cut through the middle. -->
                <WrapPanel Grid.Column="0" Orientation="Horizontal" ItemHeight="28" Height="28" ClipToBounds="True"
                           VerticalAlignment="Center">
                    <WrapPanel.Styles>
                        <Style Selector="WrapPanel > :is(Control)">
                            <Setter Property="Margin" Value="0,0,6,0" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </WrapPanel.Styles>
                    <Border Classes="chip" Classes.warn="{Binding FormatMismatch}"
                            ToolTip.Tip="{Binding DetectedFormatBadge, FallbackValue='File type from its magic bytes, not its extension.'}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:CinderIcon Data="{x:Static c:Icons.Doc}" Width="13" Height="13"
                                          Foreground="{DynamicResource CinderForegroundMutedBrush}" />
                            <TextBlock Text="{Binding FormatChip}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <!-- The detail (magic bytes, or why the extension disagrees) sits beside the chip
                         rather than inside it, so on a narrow window it gives way before the type does. -->
                    <TextBlock Text="{Binding FormatChipNote}" FontSize="12" Classes="dim" MaxWidth="170" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding FormatChipNote}"
                               IsVisible="{Binding FormatChipNote, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <Border Classes="chip" ToolTip.Tip="{Binding SizeTip}">
                        <TextBlock Text="{Binding SizeDisplay}" Classes="mono" FontSize="12" VerticalAlignment="Center" />
                    </Border>

                    <!-- SHA-256 of every byte: copyable when done, progress while running, on request above 2 GiB. -->
                    <Button Classes="ghost" Height="24" Padding="8,0" Background="{DynamicResource CinderSurface2Brush}"
                            CornerRadius="5"
                            IsVisible="{Binding QuickHashSha256Full, Converter={x:Static ObjectConverters.IsNotNull}}"
                            ToolTip.Tip="{Binding QuickHashSha256Full, StringFormat='SHA-256 of the whole file — click to copy&#10;{0}'}"
                            Command="{Binding CopyQuickHashCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="SHA-256" FontSize="12" Classes="dim" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding QuickHashSha256}" Classes="mono" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource CinderForegroundBrush}" />
                            <c:CinderIcon Data="{x:Static c:Icons.Copy}" Width="12" Height="12" />
                        </StackPanel>
                    </Button>
                    <Border Classes="chip" IsVisible="{Binding HashIsRunning}"
                            ToolTip.Tip="Hashing the whole file in the background. Switching tabs cancels it.">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="SHA-256" FontSize="12" Classes="dim" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding HashStatus}" Classes="mono muted" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button Classes="tb" Height="24" IsVisible="{Binding CanStartHash}" Command="{Binding StartHashCommand}"
                            ToolTip.Tip="Files over 2 GiB are hashed on request — it reads every byte.">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:CinderIcon Data="{x:Static c:Icons.Hash}" Width="13" Height="13" />
                            <TextBlock Text="Hash SHA-256" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <!-- Find: takes the room that is left, so there is space to type a real query. -->
                    <Border Grid.Column="1" Classes="field" MaxWidth="460" Height="28" Padding="9,0,3,0"
                            Margin="8,0,6,0" VerticalAlignment="Center">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                            <c:CinderIcon Data="{x:Static c:Icons.Search}" Width="14" Height="14"
                                          Foreground="{DynamicResource CinderForegroundDisabledBrush}" />
                            <TextBox Grid.Column="1" x:Name="FindBox" Classes="bare" Margin="7,0,6,0" FontSize="12.5"
                                     Watermark="Find…" Text="{Binding FindQuery}"
                                     ToolTip.Tip="Find (Ctrl+F). Enter runs, F3 / Shift+F3 step, Esc clears.">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding RunFindCommand}" />
                                    <KeyBinding Gesture="Shift+Enter" Command="{Binding FindPreviousCommand}" />
                                    <KeyBinding Gesture="Escape" Command="{Binding ClearFindCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                            <TextBlock Grid.Column="2" Text="{Binding FindStatus}" Classes="mono dim" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,4,0" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal"
                                        IsVisible="{Binding SearchResults.Count}">
                                <Button Classes="ghost icon" Width="20" Height="20" ToolTip.Tip="Previous (Shift+F3)"
                                        Command="{Binding FindPreviousCommand}">
                                    <c:CinderIcon Data="{x:Static c:Icons.ChevronDown}" Width="12" Height="12">
                                        <c:CinderIcon.RenderTransform><RotateTransform Angle="180" /></c:CinderIcon.RenderTransform>
                                    </c:CinderIcon>
                                </Button>
                                <Button Classes="ghost icon" Width="20" Height="20" ToolTip.Tip="Next (F3)"
                                        Command="{Binding FindNextCommand}">
                                    <c:CinderIcon Data="{x:Static c:Icons.ChevronDown}" Width="12" Height="12" />
                                </Button>
                            </StackPanel>
                            <Border Grid.Column="4" Classes="seg" Margin="4,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Classes="seg" Classes.on="{Binding FindIsAscii}" Content="ASCII"
                                            Command="{Binding SetFindKindCommand}" CommandParameter="ascii"
                                            ToolTip.Tip="Text, case-insensitive" />
                                    <Button Classes="seg" Classes.on="{Binding FindIsUtf16}" Content="UTF-16"
                                            Command="{Binding SetFindKindCommand}" CommandParameter="utf16"
                                            ToolTip.Tip="UTF-16LE text — Windows registry, LNK, EVTX strings" />
                                    <Button Classes="seg" Classes.on="{Binding FindIsHex}" Content="Hex"
                                            Command="{Binding SetFindKindCommand}" CommandParameter="hex"
                                            ToolTip.Tip="Byte pattern, e.g. 4D 5A 90 00" />
                                    <Button Classes="seg" Classes.on="{Binding FindIsRegex}" Content="Regex"
                                            Command="{Binding SetFindKindCommand}" CommandParameter="regex"
                                            ToolTip.Tip=".NET regular expression over ASCII" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                <!-- What else you can do: jump, switch text encoding, bookmark, hand off. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="tb icon" ToolTip.Tip="Go to offset (Ctrl+G): hex with 0x, or decimal"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenGotoCommand}">
                        <c:CinderIcon Data="{x:Static c:Icons.Goto}" Width="14" Height="14" />
                    </Button>

                    <Border Width="1" Height="18" Background="{DynamicResource CinderBorderStrongBrush}" Margin="4,0" />

                    <Border Classes="seg" ToolTip.Tip="How the right-hand text pane decodes bytes">
                        <StackPanel Orientation="Horizontal">
                            <Button Classes="seg" Classes.on="{Binding !TextIsUtf16}" Content="ASCII"
                                    Command="{Binding SetTextEncodingCommand}" CommandParameter="ascii" />
                            <Button Classes="seg" Classes.on="{Binding TextIsUtf16}" Content="UTF-16"
                                    Command="{Binding SetTextEncodingCommand}" CommandParameter="utf16" />
                        </StackPanel>
                    </Border>

                    <Button Classes="tb icon" ToolTip.Tip="Bookmark caret (Ctrl+D)" Command="{Binding AddBookmarkCommand}">
                        <c:CinderIcon Data="{x:Static c:Icons.Bookmark}" Width="14" Height="14" />
                    </Button>
                    <Button Classes="tb" ToolTip.Tip="Extract every printable string from this file in the Strings tool"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenInStringsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Strings" VerticalAlignment="Center" />
                            <c:CinderIcon Data="{x:Static c:Icons.Out}" Width="13" Height="13" />
                        </StackPanel>
                    </Button>
                    <Button Classes="ghost icon" ToolTip.Tip="How to use the hex viewer (F1)"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenHelpCommand}">
                        <c:CinderIcon Data="{x:Static c:Icons.Help}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ Body ============================ -->
        <Panel Grid.Row="1" Background="{DynamicResource CinderBackground0Brush}">

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="420"
                        IsVisible="{Binding Buffer, Converter={x:Static ObjectConverters.IsNull}}">
                <Border Width="52" Height="52" CornerRadius="12" HorizontalAlignment="Center"
                        Background="{DynamicResource CinderSurface2Brush}"
                        BorderBrush="{DynamicResource CinderBorderStrongBrush}" BorderThickness="1">
                    <c:CinderIcon Data="{x:Static c:Icons.Hex}" Width="24" Height="24"
                                  Foreground="{DynamicResource CinderAccentBrush}" />
                </Border>
                <TextBlock Text="No file open" FontSize="18" FontWeight="600" HorizontalAlignment="Center" />
                <TextBlock TextAlignment="Center" TextWrapping="Wrap" Classes="muted" FontSize="13"
                           Text="Open any file to read its raw bytes. Files are memory-mapped and opened read-only, so a 100 GB disk image opens as fast as a text file." />
                <Button Classes="accent" HorizontalAlignment="Center" Height="30" Padding="14,0"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenFileCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Open file…" VerticalAlignment="Center" />
                        <Border Classes="kbd" BorderBrush="#40000000"><TextBlock Text="Ctrl O" Foreground="{DynamicResource CinderOnAccentBrush}" /></Border>
                    </StackPanel>
                </Button>
                <TextBlock Text="or drop a file anywhere on this pane" Classes="dim" FontSize="12" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Grid + entropy minimap (which is also the scrollbar) -->
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Buffer, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden">
                    <hx:HexViewer x:Name="Viewer"
                                  Buffer="{Binding Buffer}"
                                  ScrollOffset="{Binding ScrollOffset, Mode=TwoWay}"
                                  CaretOffset="{Binding CaretOffset, Mode=TwoWay}"
                                  SelectionStart="{Binding SelectionStart, Mode=TwoWay}"
                                  SelectionEnd="{Binding SelectionEnd, Mode=TwoWay}"
                                  Bookmarks="{Binding Bookmarks}"
                                  SearchHits="{Binding SearchResults}"
                                  TextIsUtf16="{Binding TextIsUtf16}"
                                  BytesPerRow="{Binding BytesPerRow}"
                                  CinderFontSize="13" />
                </ScrollViewer>
                <hx:HexMinimap Grid.Column="1"
                               Buffer="{Binding Buffer}"
                               ScrollOffset="{Binding ScrollOffset, Mode=TwoWay}"
                               BytesPerRow="{Binding BytesPerRow}"
                               VisibleRows="{Binding #Viewer.VisibleRowCount}" />
            </Grid>
        </Panel>
    </Grid>
</UserControl>
