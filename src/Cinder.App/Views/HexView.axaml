<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cinder.App.ViewModels"
             xmlns:hx="using:Cinder.Hex"
             x:Class="Cinder.App.Views.HexView"
             x:DataType="vm:HexViewModel">
    <Grid RowDefinitions="Auto,*">

        <!-- Header strip: filename + format chip + sig-mismatch badge / SHA on primary line,
             DetectedRouting hint demoted to a smaller secondary line below. -->
        <Border Grid.Row="0"
                Background="{DynamicResource CinderBackground1Brush}"
                BorderBrush="{DynamicResource CinderBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,8">
            <StackPanel Spacing="3">
                <!-- Primary line -->
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <TextBlock Text="{Binding Buffer.DisplayName, FallbackValue='No file open'}"
                               FontWeight="500"
                               Foreground="{DynamicResource CinderForegroundBrush}"
                               VerticalAlignment="Center" />
                    <Border Padding="6,2"
                            CornerRadius="3"
                            Background="{DynamicResource CinderBackground2Brush}"
                            VerticalAlignment="Center"
                            IsVisible="{Binding DetectedFormat, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{Binding DetectedFormat}"
                                   FontSize="{DynamicResource CinderFontSizeXs}"
                                   Foreground="{DynamicResource CinderForegroundMutedBrush}" />
                    </Border>
                    <TextBlock Text="{Binding DetectedFormatBadge}"
                               Foreground="{DynamicResource CinderWarnBrush}"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource CinderFontSizeXs}"
                               IsVisible="{Binding DetectedFormatBadge, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Text="{Binding QuickHashSha256, StringFormat='SHA-256 {0}'}"
                               Foreground="{DynamicResource CinderForegroundMutedBrush}"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource CinderFontFamilyMono}"
                               FontSize="{DynamicResource CinderFontSizeXs}"
                               IsVisible="{Binding QuickHashSha256, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
                <!-- Secondary line: routing hint, demoted -->
                <TextBlock Text="{Binding DetectedRouting}"
                           Foreground="{DynamicResource CinderForegroundDisabledBrush}"
                           FontSize="10"
                           LetterSpacing="0.2"
                           IsVisible="{Binding DetectedRouting, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </Border>

        <!-- Body: hex pane OR empty-state placeholder -->
        <Panel Grid.Row="1" Background="{DynamicResource CinderBackground0Brush}">

            <!-- Empty state — shown when no buffer is open -->
            <Border Background="{DynamicResource CinderBackground0Brush}"
                    IsVisible="{Binding Buffer, Converter={x:Static ObjectConverters.IsNull}}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="14"
                            MaxWidth="420">
                    <Border CornerRadius="8"
                            Background="{DynamicResource CinderBackground1Brush}"
                            Padding="22"
                            HorizontalAlignment="Center">
                        <TextBlock Text="🔥" FontSize="56"
                                   Foreground="{DynamicResource CinderAccentBrush}" />
                    </Border>
                    <TextBlock Text="Drop a file to begin"
                               FontSize="{DynamicResource CinderFontSizeLg}"
                               FontWeight="600"
                               Foreground="{DynamicResource CinderForegroundBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource CinderForegroundMutedBrush}">
                        <Run Text="Drop a file anywhere on this pane, or press " />
                        <Run Text="Ctrl+O" Foreground="{DynamicResource CinderAccentBrush}" />
                        <Run Text=" to pick one. Cinder reads memory-mapped — opening a 100 GB image is instant." />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Real hex pane — only when there's a buffer -->
            <ScrollViewer IsVisible="{Binding Buffer, Converter={x:Static ObjectConverters.IsNotNull}}"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Visible">
                <hx:HexViewer Buffer="{Binding Buffer}"
                              ScrollOffset="{Binding ScrollOffset, Mode=TwoWay}"
                              CaretOffset="{Binding CaretOffset, Mode=TwoWay}"
                              SelectionStart="{Binding SelectionStart, Mode=TwoWay}"
                              SelectionEnd="{Binding SelectionEnd, Mode=TwoWay}"
                              Bookmarks="{Binding Bookmarks}"
                              BytesPerRow="{Binding BytesPerRow}" />
            </ScrollViewer>
        </Panel>
    </Grid>
</UserControl>
