<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Cinder.App.Controls"
             xmlns:vm="using:Cinder.App.ViewModels"
             xmlns:rep="using:Cinder.Reports"
             x:Class="Cinder.App.Views.Tools.ReportsView"
             x:DataType="vm:ReportsToolViewModel">
    <!-- Left: what the report is and what goes in it. Right: write a section, see the result. -->
    <Grid ColumnDefinitions="330,4,*">

        <Border Grid.Column="0" Background="{DynamicResource CinderSurface1Brush}">
            <DockPanel Margin="16,14">
                <StackPanel DockPanel.Dock="Top" Spacing="10">
                    <TextBlock Text="REPORT" Classes="section" />
                    <StackPanel Spacing="4">
                        <TextBlock Text="Title" Classes="label" FontSize="11.5" />
                        <TextBox Text="{Binding Title, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Examiner" Classes="label" FontSize="11.5" />
                        <TextBox Text="{Binding Examiner, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Template" Classes="label" FontSize="11.5" />
                        <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" HorizontalAlignment="Stretch"
                                  ToolTip.Tip="A template is a starting set of sections. Choosing another one replaces the sections below.">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="rep:ReportTemplate">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <!-- Export, pinned to the bottom: the last thing you do. -->
                <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
                    <Border Height="1" Background="{DynamicResource CinderBorderBrush}" />
                    <TextBlock Text="EXHIBITS FROM BOOKMARKS" Classes="section" Margin="0,4,0,0" />
                    <Grid ColumnDefinitions="Auto,*">
                        <Button Classes="tb" Height="28" Content="Load bookmarks" Command="{Binding LoadBookmarksCommand}"
                                ToolTip.Tip="Reads the open case's bookmarks so they can be included as numbered exhibits" />
                        <CheckBox Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                  IsChecked="{Binding IncludeBookmarks}" Content="Include in the report" />
                    </Grid>
                    <TextBlock Text="{Binding BookmarkSummary}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    <c:ExportButton Classes="accent" Height="30" HorizontalAlignment="Left" Margin="0,4,0,0"
                                    ExportCommand="{Binding ExportCommand}" Formats="pdf,docx,html,md,json" />
                    <TextBlock Text="{Binding StatusLine}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                               IsVisible="{Binding StatusLine, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>

                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,16,0,6">
                    <TextBlock Text="SECTIONS" Classes="section" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="ghost" Height="22" Padding="8,0" FontSize="11.5" Command="{Binding AddSectionCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <c:CinderIcon Data="{x:Static c:Icons.Plus}" Width="12" Height="12" />
                            <TextBlock Text="Add" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
                <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:DraftSection">
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" />

        <Grid Grid.Column="2" RowDefinitions="*,4,*">
            <DockPanel Grid.Row="0" Margin="16,14">
                <TextBlock DockPanel.Dock="Top" Text="SECTION" Classes="section" Margin="0,0,0,8" />
                <TextBox DockPanel.Dock="Top" Text="{Binding SelectedSection.Title, Mode=TwoWay, FallbackValue=''}"
                         FontWeight="600" FontSize="14" Margin="0,0,0,8" Watermark="Section heading" />
                <TextBox Text="{Binding SelectedSection.Body, Mode=TwoWay, FallbackValue=''}"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                         FontFamily="{DynamicResource CinderFontFamilyMono}" FontSize="12.5"
                         Watermark="Write this section here. Plain text works; Markdown is supported if you want it (# heading, **bold**, - list item)." />
            </DockPanel>
            <GridSplitter Grid.Row="1" />
            <Border Grid.Row="2" Background="{DynamicResource CinderSurface1Brush}">
                <DockPanel Margin="16,12">
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBlock Text="PREVIEW (AS MARKDOWN)" Classes="section" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="ghost" Height="22" Padding="8,0" FontSize="11.5" Content="Update preview"
                                Command="{Binding RefreshCommand}" />
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <SelectableTextBlock Text="{Binding PreviewMarkdown}" Classes="mono" FontSize="12" TextWrapping="Wrap" LineHeight="18" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
