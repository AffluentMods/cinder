<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cinder.App.ViewModels"
             xmlns:rep="using:Cinder.Reports"
             x:Class="Cinder.App.Views.Tools.ReportsView"
             x:DataType="vm:ReportsToolViewModel">
    <Grid ColumnDefinitions="320,4,*" Margin="0">

        <!-- Left column: template + sections + export -->
        <Border Grid.Column="0" Background="{DynamicResource CinderBackground1Brush}">
            <DockPanel Margin="14">
                <TextBlock DockPanel.Dock="Top" Text="REPORT"
                           FontWeight="600"
                           FontSize="{DynamicResource CinderFontSizeXs}"
                           Foreground="{DynamicResource CinderForegroundDisabledBrush}"
                           Margin="0,0,0,10" />
                <StackPanel DockPanel.Dock="Top" Spacing="10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Title" FontSize="{DynamicResource CinderFontSizeXs}"
                                   Foreground="{DynamicResource CinderForegroundMutedBrush}" />
                        <TextBox Text="{Binding Title, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Examiner" FontSize="{DynamicResource CinderFontSizeXs}"
                                   Foreground="{DynamicResource CinderForegroundMutedBrush}" />
                        <TextBox Text="{Binding Examiner, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Template" FontSize="{DynamicResource CinderFontSizeXs}"
                                   Foreground="{DynamicResource CinderForegroundMutedBrush}" />
                        <ComboBox ItemsSource="{Binding Templates}"
                                  SelectedItem="{Binding SelectedTemplate}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="rep:ReportTemplate">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,*" Margin="0,10,0,0">
                    <Button Grid.Column="0" Margin="0,0,4,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Content="Add section" Command="{Binding AddSectionCommand}" />
                    <Button Grid.Column="1" Margin="4,0,0,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Content="Refresh"  Command="{Binding RefreshCommand}" />
                </Grid>

                <Border DockPanel.Dock="Bottom" Background="{DynamicResource CinderBackground2Brush}"
                        CornerRadius="4" Padding="10" Margin="0,10,0,8">
                    <StackPanel Spacing="6">
                        <TextBlock Text="EXPORT" FontWeight="600"
                                   FontSize="{DynamicResource CinderFontSizeXs}"
                                   Foreground="{DynamicResource CinderForegroundMutedBrush}" />
                        <UniformGrid Rows="2" Columns="3">
                            <Button Content="Markdown" Command="{Binding ExportCommand}" CommandParameter="md"   Margin="2" />
                            <Button Content="HTML"     Command="{Binding ExportCommand}" CommandParameter="html" Margin="2" />
                            <Button Content="PDF"      Command="{Binding ExportCommand}" CommandParameter="pdf"  Margin="2" />
                            <Button Content="DOCX"     Command="{Binding ExportCommand}" CommandParameter="docx" Margin="2" />
                            <Button Content="JSON"     Command="{Binding ExportCommand}" CommandParameter="json" Margin="2" />
                            <Border />
                        </UniformGrid>
                        <TextBlock Text="{Binding StatusLine}"
                                   FontSize="{DynamicResource CinderFontSizeXs}"
                                   Foreground="{DynamicResource CinderForegroundMutedBrush}"
                                   IsVisible="{Binding StatusLine, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:DraftSection">
                            <TextBlock Text="{Binding Title}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Background="{DynamicResource CinderBorderBrush}" />

        <!-- Right column: section editor + preview -->
        <Grid Grid.Column="2" RowDefinitions="*,4,*">
            <Border Grid.Row="0" Background="{DynamicResource CinderBackground0Brush}" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="SECTION"
                               FontWeight="600"
                               FontSize="{DynamicResource CinderFontSizeXs}"
                               Foreground="{DynamicResource CinderForegroundDisabledBrush}"
                               Margin="0,0,0,8" />
                    <TextBox DockPanel.Dock="Top"
                             Text="{Binding SelectedSection.Title, Mode=TwoWay, FallbackValue=''}"
                             FontWeight="600"
                             FontSize="{DynamicResource CinderFontSizeMd}"
                             Margin="0,0,0,8" />
                    <TextBox Text="{Binding SelectedSection.Body, Mode=TwoWay, FallbackValue=''}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             FontFamily="{DynamicResource CinderFontFamilyMono}"
                             FontSize="{DynamicResource CinderFontSizeSm}" />
                </DockPanel>
            </Border>
            <GridSplitter Grid.Row="1" Background="{DynamicResource CinderBorderBrush}" />
            <Border Grid.Row="2" Background="{DynamicResource CinderBackground1Brush}" Padding="14">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBlock Grid.Column="0" Text="MARKDOWN PREVIEW"
                                   FontWeight="600"
                                   FontSize="{DynamicResource CinderFontSizeXs}"
                                   Foreground="{DynamicResource CinderForegroundDisabledBrush}" />
                        <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}"
                                FontSize="{DynamicResource CinderFontSizeXs}" Padding="8,3" />
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <SelectableTextBlock Text="{Binding PreviewMarkdown}"
                                             FontFamily="{DynamicResource CinderFontFamilyMono}"
                                             FontSize="{DynamicResource CinderFontSizeXs}"
                                             Foreground="{DynamicResource CinderForegroundBrush}"
                                             TextWrapping="Wrap" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
