<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Cinder.App.Controls"
             xmlns:tools="using:Cinder.App.ViewModels.Tools"
             x:Class="Cinder.App.Views.Tools.CarverView"
             x:DataType="tools:CarverTool">
    <!-- Two inputs in reading order (what to carve, where to put it), then Carve. -->
    <Grid RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0" Padding="14,12,12,12" BorderBrush="{DynamicResource CinderBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Spacing="8" MaxWidth="900" HorizontalAlignment="Left">
                <Grid ColumnDefinitions="120,560,Auto">
                    <TextBlock Text="Carve from" Classes="label" />
                    <TextBox Grid.Column="1" Text="{Binding Source}" Watermark="A disk image, memory dump or any file"
                             FontFamily="{DynamicResource CinderFontFamilyMono}" />
                    <Button Grid.Column="2" Classes="tb" Margin="6,0,0,0" Height="28" Content="Pick…" Command="{Binding PickSourceCommand}" />
                </Grid>
                <Grid ColumnDefinitions="120,560,Auto">
                    <TextBlock Text="Save files to" Classes="label" />
                    <TextBox Grid.Column="1" Text="{Binding OutputDir}" Watermark="An empty folder, not on the evidence drive"
                             FontFamily="{DynamicResource CinderFontFamilyMono}" />
                    <Button Grid.Column="2" Classes="tb" Margin="6,0,0,0" Height="28" Content="Pick…" Command="{Binding PickOutputDirCommand}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="120,2,0,0">
                    <Button Classes="accent" Height="30" Padding="14,0" Command="{Binding RunCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <c:CinderIcon Data="{x:Static c:Icons.Cut}" Width="15" Height="15" />
                            <TextBlock Text="Carve" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tb" Height="30" Content="Stop" Command="{Binding RunCancelCommand}"
                            IsVisible="{Binding RunCommand.IsRunning}" />
                    <ProgressBar IsIndeterminate="True" Width="120" VerticalAlignment="Center" IsVisible="{Binding RunCommand.IsRunning}" />
                    <c:ExportButton ExportCommand="{Binding ExportCommand}" Height="30" IsVisible="{Binding Hits.Count}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Panel Grid.Row="1">
            <DataGrid ItemsSource="{Binding Hits}" SelectedItem="{Binding SelectedHit}" AutoGenerateColumns="False" IsReadOnly="True"
                      IsVisible="{Binding Hits.Count}" DoubleTapped="OnHitDoubleTapped">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Type" Binding="{Binding Label}" Width="200" />
                    <DataGridTextColumn Header="Extension" Binding="{Binding Extension}" Width="100"
                                        FontFamily="{StaticResource CinderFontFamilyMono}" />
                    <DataGridTextColumn Header="Found at" Binding="{Binding Offset, StringFormat='0x{0:X12}'}" Width="150"
                                        FontFamily="{StaticResource CinderFontFamilyMono}" />
                    <DataGridTextColumn Header="Size (bytes)" Binding="{Binding Length, StringFormat=N0}" Width="130"
                                        FontFamily="{StaticResource CinderFontFamilyMono}" />
                    <DataGridCheckBoxColumn Header="Structure checked" Binding="{Binding Validated}" Width="140" />
                    <DataGridTextColumn Header="Saved as" Binding="{Binding OutputPath}" Width="2*"
                                        FontFamily="{StaticResource CinderFontFamilyMono}" />
                    <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <c:EmptyState Icon="{Binding IconGeometry}" Title="Recover files by their signatures" IsVisible="{Binding !Hits.Count}"
                          Message="Carving ignores the file system and looks for the byte patterns that start (and end) known file types: pictures, documents, archives, databases. It finds deleted files and files in unallocated space. Names and folders are not recovered, and a fragmented file may come out incomplete." />
        </Panel>

        <Border Grid.Row="2" Classes="footer">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="{Binding Hits.Count, StringFormat='{}{0:N0} files'}" Classes="mono" IsVisible="{Binding Hits.Count}" />
                <TextBlock Grid.Column="1" Text="{Binding StatusLine}" Margin="16,0,0,0" />
                <TextBlock Grid.Column="2" Text="Double-click a file to open it in the Hex Viewer" IsVisible="{Binding Hits.Count}"
                           Foreground="{DynamicResource CinderForegroundDisabledBrush}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
