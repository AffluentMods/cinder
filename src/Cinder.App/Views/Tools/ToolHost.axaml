<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:Cinder.App.ViewModels"
                    xmlns:tools="using:Cinder.App.ViewModels.Tools"
                    xmlns:views="using:Cinder.App.Views"
                    xmlns:tv="using:Cinder.App.Views.Tools"
                    xmlns:c="using:Cinder.App.Controls">

    <DataTemplate x:Key="ToolContentTemplate" DataType="tools:ToolViewModel">
        <Panel>
            <Grid IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='hex'}"
                  RowDefinitions="38,*">
                <!-- Open files as browser-style tabs: active one raised with an ember top edge,
                     close on hover, full path on hover, + opens another file. -->
                <Border Grid.Row="0"
                        Background="{DynamicResource CinderSurface0Brush}"
                        BorderBrush="{DynamicResource CinderBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="8,0">
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Bottom">
                        <ItemsControl ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenBuffers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:HexViewModel">
                                    <Border Classes="tab" Classes.on="{Binding IsActiveTab}"
                                            ToolTip.Tip="{Binding SourcePath}">
                                        <StackPanel Orientation="Horizontal" Spacing="2" Margin="4,0,6,0">
                                            <Button Classes="ghost" Background="Transparent" Height="30" Padding="8,0"
                                                    Foreground="{DynamicResource CinderForegroundBrush}"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetActiveBufferCommand}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <c:CinderIcon Data="{x:Static c:Icons.Hex}" Width="14" Height="14" />
                                                    <TextBlock Text="{Binding TabTitle}" FontSize="12.5" VerticalAlignment="Center"
                                                               MaxWidth="220" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="ghost icon tabclose" Width="20" Height="20" VerticalAlignment="Center"
                                                    ToolTip.Tip="Close (Ctrl+W)"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CloseBufferCommand}"
                                                    CommandParameter="{Binding}">
                                                <c:CinderIcon Data="{x:Static c:Icons.Close}" Width="12" Height="12" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="ghost icon" Width="28" Height="28" Margin="2,0,0,3" VerticalAlignment="Bottom"
                                ToolTip.Tip="Open file (Ctrl+O)"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenFileCommand}">
                            <c:CinderIcon Data="{x:Static c:Icons.Plus}" Width="14" Height="14" />
                        </Button>
                    </StackPanel>
                </Border>
                <ContentControl Grid.Row="1"
                                Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Hex}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="vm:HexViewModel">
                            <views:HexView />
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Grid>

            <ContentControl IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='reports'}"
                            Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Reports}">
                <ContentControl.ContentTemplate>
                    <DataTemplate DataType="vm:ReportsToolViewModel"><tv:ReportsView /></DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
            <ContentControl IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='timeline'}"
                            Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Timeline}">
                <ContentControl.ContentTemplate>
                    <DataTemplate DataType="vm:TimelineToolViewModel"><tv:TimelineView /></DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
            <ContentControl IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='search'}"
                            Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Search}">
                <ContentControl.ContentTemplate>
                    <DataTemplate DataType="vm:SearchToolViewModel"><tv:SearchView /></DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
            <ContentControl IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='ai'}"
                            Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Ai}">
                <ContentControl.ContentTemplate>
                    <DataTemplate DataType="vm:AiCopilotToolViewModel"><tv:AiCopilotView /></DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

            <!-- Home / Dashboard. Bound to the typed Workspace.Dashboard so it always gets the
                 same instance (recent-cases live there). -->
            <ContentControl IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='dashboard'}"
                            Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Workspace.Dashboard}">
                <ContentControl.ContentTemplate>
                    <DataTemplate DataType="tools:DashboardTool"><tv:DashboardView /></DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

            <tv:GalleryView    IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='gallery'}" />
            <tv:StringsView    IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='strings'}" />
            <tv:DocumentsView  IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='documents'}" />
            <tv:CasesView      IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='cases'}" />
            <tv:CustodyView    IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='custody'}" />
            <tv:HashSetsView   IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='hashsets'}" />
            <tv:YaraView       IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='yara'}" />
            <tv:VirusTotalView IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='virustotal'}" />
            <tv:MapView        IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='map'}" />
            <tv:GraphView      IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='graph'}" />
            <tv:ImagerView     IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='imager'}" />
            <tv:VerifyView     IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='verify'}" />
            <tv:MountView      IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='mount'}" />
            <tv:ConvertView    IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='convert'}" />
            <tv:ShadowCopyView IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='shadowcopy'}" />
            <tv:RamCaptureView IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='ramcapture'}" />
            <tv:CarverView     IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='carver'}" />
            <tv:CloudView      IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='cloud'}" />
            <tv:WorkflowsView  IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='workflows'}" />
            <tv:PluginsView    IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='plugins'}" />
            <tv:SettingsView   IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='settings'}" />

            <tv:IocMatchView   IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='ioc'}" />
            <tv:BookmarksView  IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='bookmarks'}" />

            <tv:SidecarRunnerView IsVisible="{Binding ., Converter={x:Static tools:ToolKindHelpers.HasSidecar}}" />
        </Panel>
    </DataTemplate>

</ResourceDictionary>
