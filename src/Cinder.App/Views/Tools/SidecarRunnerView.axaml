<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tools="using:Cinder.App.ViewModels.Tools"
             xmlns:c="using:Cinder.App.Controls"
             x:Class="Cinder.App.Views.Tools.SidecarRunnerView"
             x:DataType="tools:SidecarToolViewModel">
    <!--
        The shared surface for every grid-producing parser (registry, EVTX, prefetch, LNK, …).
        Toolbar: what was parsed · filter · act on it. Banners for truncation and errors sit
        between toolbar and grid, where they can't be missed. Picking or dropping evidence runs
        the parser straight away.
    -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- ============================ Toolbar ============================ -->
        <Border Grid.Row="0" Height="44" Padding="14,0,12,0"
                BorderBrush="{DynamicResource CinderBorderBrush}" BorderThickness="0,0,0,1"
                IsVisible="{Binding EvidencePath, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border Classes="chip" ToolTip.Tip="{Binding EvidencePath}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:CinderIcon Data="{x:Static c:Icons.Doc}" Width="13" Height="13"
                                          Foreground="{DynamicResource CinderForegroundMutedBrush}" />
                            <TextBlock Text="{Binding EvidenceName}" Classes="mono" FontSize="12" VerticalAlignment="Center"
                                       MaxWidth="280" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Button Classes="tb" Content="Change…" Click="OnPickEvidenceClick"
                            ToolTip.Tip="Parse a different file" />
                    <Button Classes="tb icon" ToolTip.Tip="Run again"
                            Command="{Binding LoadEvidenceCommand}" CommandParameter="{Binding EvidencePath}">
                        <c:CinderIcon Data="{x:Static c:Icons.Swap}" Width="14" Height="14" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            IsVisible="{Binding Rows.Count}">
                    <Border Classes="field" Width="260" Height="28" Padding="9,0,8,0">
                        <Grid ColumnDefinitions="Auto,*">
                            <c:CinderIcon Data="{x:Static c:Icons.Filter}" Width="14" Height="14"
                                          Foreground="{DynamicResource CinderForegroundDisabledBrush}" />
                            <TextBox Grid.Column="1" Classes="bare" Margin="8,0,0,0" FontSize="12.5"
                                     Watermark="Filter rows"
                                     Text="{Binding RowFilter, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip.Tip="Substring across every column. Export writes what the filter shows." />
                        </Grid>
                    </Border>

                    <!-- Bookmark: the note is part of the finding, so it lives with the action. -->
                    <Button Classes="tb" ToolTip.Tip="Flag the selected row as a finding in the open case. Reports turns bookmarks into exhibits.">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:CinderIcon Data="{x:Static c:Icons.Bookmark}" Width="14" Height="14" />
                            <TextBlock Text="Bookmark" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="300" Spacing="10">
                                    <TextBlock Text="BOOKMARK SELECTED ROW" Classes="section" />
                                    <TextBox Watermark="Note (optional) — why this row matters"
                                             Text="{Binding BookmarkNote}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
                                    <Button Classes="accent" HorizontalAlignment="Right" Content="Add bookmark"
                                            Command="{Binding BookmarkSelectedCommand}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button Classes="tb" ToolTip.Tip="Write the filtered rows to a file">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:CinderIcon Data="{x:Static c:Icons.Download}" Width="14" Height="14" />
                            <TextBlock Text="Export" VerticalAlignment="Center" />
                            <c:CinderIcon Data="{x:Static c:Icons.ChevronDown}" Width="12" Height="12" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="CSV (formula-injection safe)" Command="{Binding ExportCommand}" CommandParameter="csv" />
                                <MenuItem Header="JSON array" Command="{Binding ExportCommand}" CommandParameter="json" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Truncation: what you see is not the whole artefact. Must be impossible to miss. -->
        <Border Grid.Row="1" IsVisible="{Binding IsTruncated}" Padding="14,8"
                Background="{DynamicResource CinderWarnSoftBrush}"
                BorderBrush="{DynamicResource CinderWarnBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*">
                <c:CinderIcon Data="{x:Static c:Icons.Alert}" Width="15" Height="15" VerticalAlignment="Top" Margin="0,1,10,0"
                              Foreground="{DynamicResource CinderWarnBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding StatusLine}" TextWrapping="Wrap" FontWeight="500" />
            </Grid>
        </Border>

        <!-- Parser error -->
        <Border Grid.Row="2" Padding="14,8"
                BorderBrush="{DynamicResource CinderDangerBrush}" BorderThickness="0,0,0,1"
                IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Border.Background>
                <SolidColorBrush Color="{DynamicResource CinderDangerColor}" Opacity="0.09" />
            </Border.Background>
            <Grid ColumnDefinitions="Auto,*">
                <c:CinderIcon Data="{x:Static c:Icons.Alert}" Width="15" Height="15" VerticalAlignment="Top" Margin="0,1,10,0"
                              Foreground="{DynamicResource CinderDangerBrush}" />
                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="The parser couldn't read this file." FontWeight="500" />
                    <SelectableTextBlock Text="{Binding ErrorMessage}" Classes="mono" TextWrapping="Wrap" FontSize="12"
                                         Foreground="{DynamicResource CinderForegroundMutedBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ Empty state ============================ -->
        <Panel Grid.Row="3" IsVisible="{Binding EvidencePath, Converter={x:Static ObjectConverters.IsNull}}"
               Background="{DynamicResource CinderBackground0Brush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Spacing="14">
                <Border Width="52" Height="52" CornerRadius="12" HorizontalAlignment="Center"
                        Background="{DynamicResource CinderSurface2Brush}"
                        BorderBrush="{DynamicResource CinderBorderStrongBrush}" BorderThickness="1">
                    <c:CinderIcon Data="{Binding IconGeometry}" Width="24" Height="24"
                                  Foreground="{DynamicResource CinderAccentBrush}" />
                </Border>
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="600" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding EmptyStateHint}" Classes="muted" FontSize="13"
                           TextAlignment="Center" TextWrapping="Wrap" />
                <StackPanel Spacing="6" HorizontalAlignment="Center" IsVisible="{Binding RequiredPythonPackages.Count}">
                    <TextBlock Text="NEEDS" Classes="section" HorizontalAlignment="Center" />
                    <ItemsControl ItemsSource="{Binding RequiredPythonPackages}" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="chip" Margin="3">
                                    <TextBlock Text="{Binding}" Classes="mono" FontSize="12" VerticalAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Button Classes="accent" HorizontalAlignment="Center" Height="30" Padding="14,0"
                        Content="Pick evidence…" Click="OnPickEvidenceClick" />
                <TextBlock Text="or drop a file here" Classes="dim" FontSize="12" HorizontalAlignment="Center" />
            </StackPanel>
        </Panel>

        <!-- ============================ Grid ============================ -->
        <Panel Grid.Row="3" IsVisible="{Binding EvidencePath, Converter={x:Static ObjectConverters.IsNotNull}}">
            <!-- Columns come from the row type the parser produced (see Controls/AutoColumns). -->
            <DataGrid ItemsSource="{Binding VisibleRows}" SelectedItem="{Binding SelectedRow}"
                      c:AutoColumns.FromFirstItem="True" IsReadOnly="True" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                        IsVisible="{Binding IsLoading}">
                <ProgressBar IsIndeterminate="True" Width="160" />
                <TextBlock Text="Parsing…" Classes="muted" HorizontalAlignment="Center" />
            </StackPanel>
        </Panel>

        <!-- ============================ Footer ============================ -->
        <Border Grid.Row="4" Height="28" Padding="14,0"
                Background="{DynamicResource CinderSurface1Brush}"
                BorderBrush="{DynamicResource CinderBorderBrush}" BorderThickness="0,1,0,0"
                IsVisible="{Binding EvidencePath, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="{Binding RowCountDisplay}" Classes="mono muted" FontSize="11.5" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding StatusLine}" Classes="dim" FontSize="11.5" Margin="16,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding !IsTruncated}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
