<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tools="using:Cinder.App.ViewModels.Tools"
             xmlns:c="using:Cinder.App.Controls"
             x:Class="Cinder.App.Views.Tools.SidecarRunnerView"
             x:DataType="tools:SidecarToolViewModel">
    <!--
        The shared surface for every grid-producing parser (registry, event log, prefetch, …).
        Toolbar: what was read · filter · act on it. Banners for a cut-short grid and for errors
        sit between toolbar and grid, where they can't be missed. Picking or dropping evidence
        runs the parser straight away; while it runs, picking is disabled and Stop is offered.
    -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- ============================ Toolbar ============================ -->
        <Border Grid.Row="0" Classes="toolbar"
                IsVisible="{Binding EvidencePath, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border Classes="chip" ToolTip.Tip="{Binding EvidencePath}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:CinderIcon Data="{x:Static c:Icons.Doc}" Width="13" Height="13"
                                          Foreground="{DynamicResource CinderForegroundMutedBrush}" />
                            <TextBlock Text="{Binding EvidenceName}" Classes="mono" FontSize="12" VerticalAlignment="Center"
                                       MaxWidth="280" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <!-- A tool that reads only files gets one "Change…"; one that also reads folders gets both. -->
                    <Button Classes="tb" Content="Change…" Click="OnPickFileClick"
                            IsEnabled="{Binding !IsLoading}" IsVisible="{Binding !AcceptsFolder}"
                            ToolTip.Tip="Read a different file" />
                    <Button Classes="tb" Content="Pick file…" Click="OnPickFileClick"
                            IsEnabled="{Binding !IsLoading}"
                            ToolTip.Tip="Read a single file">
                        <Button.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="AcceptsFolder" />
                                <Binding Path="AcceptsFile" />
                            </MultiBinding>
                        </Button.IsVisible>
                    </Button>
                    <Button Classes="tb" Content="Pick folder…" Click="OnPickFolderClick"
                            IsEnabled="{Binding !IsLoading}" IsVisible="{Binding AcceptsFolder}"
                            ToolTip.Tip="Read every matching file in a folder" />
                    <Button Classes="tb icon" ToolTip.Tip="Read it again"
                            Command="{Binding LoadEvidenceCommand}" CommandParameter="{Binding EvidencePath}"
                            IsVisible="{Binding !IsLoading}">
                        <c:CinderIcon Data="{x:Static c:Icons.Swap}" Width="14" Height="14" />
                    </Button>
                    <Button Classes="tb" Content="Stop" Command="{Binding LoadEvidenceCancelCommand}"
                            IsVisible="{Binding IsLoading}" ToolTip.Tip="Stop reading. Nothing is loaded." />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            IsVisible="{Binding Rows.Count}">
                    <Border Classes="field" Width="260" Height="28" Padding="9,0,8,0">
                        <Grid ColumnDefinitions="Auto,*">
                            <c:CinderIcon Data="{x:Static c:Icons.Filter}" Width="14" Height="14"
                                          Foreground="{DynamicResource CinderForegroundDisabledBrush}" />
                            <TextBox Grid.Column="1" Classes="bare" Margin="8,0,0,0" FontSize="12.5"
                                     Watermark="Filter rows"
                                     Text="{Binding RowFilter, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip.Tip="Shows rows with this text in any column. Export writes the rows the filter shows." />
                        </Grid>
                    </Border>

                    <!-- Bookmark: the note is part of the finding, so it lives with the action. -->
                    <Button Classes="tb" ToolTip.Tip="Keep the selected row as a finding in the open case. Reports turns bookmarks into exhibits.">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:CinderIcon Data="{x:Static c:Icons.Bookmark}" Width="14" Height="14" />
                            <TextBlock Text="Bookmark" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="300" Spacing="10">
                                    <TextBlock Text="BOOKMARK SELECTED ROW" Classes="section" />
                                    <TextBox Watermark="Note (optional): why this row matters"
                                             Text="{Binding BookmarkNote}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
                                    <Button Classes="accent" HorizontalAlignment="Right" Content="Add bookmark"
                                            Command="{Binding BookmarkSelectedCommand}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <c:ExportButton ExportCommand="{Binding ExportCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Cut short: what you see is not the whole artifact. Must be impossible to miss, and must
             stay put when the status line moves on to "Bookmarked" or "Exported". -->
        <Border Grid.Row="1" IsVisible="{Binding IsTruncated}" Padding="14,8"
                Background="{DynamicResource CinderWarnSoftBrush}"
                BorderBrush="{DynamicResource CinderWarnBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*">
                <c:CinderIcon Data="{x:Static c:Icons.Alert}" Width="15" Height="15" VerticalAlignment="Top" Margin="0,1,10,0"
                              Foreground="{DynamicResource CinderWarnBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding TruncationNotice}" TextWrapping="Wrap" FontWeight="500" />
            </Grid>
        </Border>

        <!-- Error: the heading says what failed (reading the evidence, or saving an export). -->
        <Border Grid.Row="2" Padding="14,8"
                BorderBrush="{DynamicResource CinderDangerBrush}" BorderThickness="0,0,0,1"
                IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Border.Background>
                <SolidColorBrush Color="{DynamicResource CinderDangerColor}" Opacity="0.09" />
            </Border.Background>
            <Grid ColumnDefinitions="Auto,*">
                <c:CinderIcon Data="{x:Static c:Icons.Alert}" Width="15" Height="15" VerticalAlignment="Top" Margin="0,1,10,0"
                              Foreground="{DynamicResource CinderDangerBrush}" />
                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="{Binding ErrorTitle}" FontWeight="500" />
                    <SelectableTextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" FontSize="12.5"
                                         Foreground="{DynamicResource CinderForegroundMutedBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ Empty state ============================ -->
        <Panel Grid.Row="3" IsVisible="{Binding EvidencePath, Converter={x:Static ObjectConverters.IsNull}}"
               Background="{DynamicResource CinderBackground0Brush}">
            <c:EmptyState Icon="{Binding IconGeometry}" Title="{Binding Title}" Message="{Binding EmptyStateHint}">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <StackPanel Spacing="6" HorizontalAlignment="Center" IsVisible="{Binding RequiredPythonPackages.Count}">
                        <TextBlock Text="NEEDS" Classes="section" HorizontalAlignment="Center" />
                        <ItemsControl ItemsSource="{Binding RequiredPythonPackages}" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="chip" Margin="3">
                                        <TextBlock Text="{Binding}" Classes="mono" FontSize="12" VerticalAlignment="Center" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <!-- One primary action. Where a tool takes either, the folder is the usual
                             case (a whole Prefetch or Recent folder) and a single file is the alternative. -->
                        <Button Classes="accent" Height="30" Padding="14,0" Content="Pick folder…"
                                Click="OnPickFolderClick" IsVisible="{Binding AcceptsFolder}" />
                        <Button Classes="accent" Height="30" Padding="14,0" Content="Pick file…" Click="OnPickFileClick">
                            <Button.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="AcceptsFile" />
                                    <Binding Path="!AcceptsFolder" />
                                </MultiBinding>
                            </Button.IsVisible>
                        </Button>
                        <Button Classes="tb" Height="30" Padding="14,0" Content="Pick a single file…" Click="OnPickFileClick">
                            <Button.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="AcceptsFile" />
                                    <Binding Path="AcceptsFolder" />
                                </MultiBinding>
                            </Button.IsVisible>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding DropHint}" Classes="dim" FontSize="12" HorizontalAlignment="Center" />
                </StackPanel>
            </c:EmptyState>
        </Panel>

        <!-- ============================ Grid ============================ -->
        <Panel Grid.Row="3" IsVisible="{Binding EvidencePath, Converter={x:Static ObjectConverters.IsNotNull}}">
            <!-- Columns come from the row type the parser produced (see Controls/AutoColumns). -->
            <DataGrid ItemsSource="{Binding VisibleRows}" SelectedItem="{Binding SelectedRow}"
                      c:AutoColumns.FromFirstItem="True" IsReadOnly="True" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                        IsVisible="{Binding IsLoading}">
                <ProgressBar IsIndeterminate="True" Width="160" />
                <TextBlock Text="{Binding StatusLine}" Classes="muted" HorizontalAlignment="Center"
                           MaxWidth="460" TextWrapping="Wrap" TextAlignment="Center" />
                <Button Classes="tb" Content="Stop" HorizontalAlignment="Center"
                        Command="{Binding LoadEvidenceCancelCommand}" />
            </StackPanel>
            <!-- Read without error and found nothing: say so, with the reason, instead of a blank grid. -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" MaxWidth="520"
                        IsVisible="{Binding ShowNoRows}">
                <TextBlock Text="Nothing to show" FontSize="15" FontWeight="600" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding StatusLine}" Classes="muted" FontSize="13"
                           TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Panel>

        <!-- ============================ Footer ============================ -->
        <Border Grid.Row="4" Classes="footer"
                IsVisible="{Binding EvidencePath, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="{Binding RowCountDisplay}" Classes="mono" />
                <TextBlock Grid.Column="1" Text="{Binding StatusLine}" Margin="16,0,0,0"
                           ToolTip.Tip="{Binding StatusLine}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
