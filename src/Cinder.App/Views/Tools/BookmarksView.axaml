<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Cinder.App.Controls"
             xmlns:tools="using:Cinder.App.ViewModels.Tools"
             x:Class="Cinder.App.Views.Tools.BookmarksView"
             x:DataType="tools:BookmarksTool">
    <!-- Everything flagged in this case, in one list. -->
    <Grid RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0" Classes="toolbar">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="tb" Command="{Binding RefreshCommand}" ToolTip.Tip="Read the list again from the case file">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:CinderIcon Data="{x:Static c:Icons.Swap}" Width="14" Height="14" />
                            <TextBlock Text="Reload" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tb" Content="Remove selected" Command="{Binding DeleteSelectedCommand}"
                            IsVisible="{Binding Bookmarks.Count}"
                            ToolTip.Tip="Withdraws the finding. The removal itself is recorded in the custody log, so nothing disappears silently." />
                </StackPanel>
                <c:ExportButton Grid.Column="2" ExportCommand="{Binding ExportCommand}" VerticalAlignment="Center"
                                IsVisible="{Binding Bookmarks.Count}" />
            </Grid>
        </Border>

        <Panel Grid.Row="1">
            <DataGrid ItemsSource="{Binding Bookmarks}" SelectedItem="{Binding Selected}"
                      AutoGenerateColumns="False" IsReadOnly="True" IsVisible="{Binding Bookmarks.Count}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="56"
                                        FontFamily="{StaticResource CinderFontFamilyMono}" />
                    <DataGridTextColumn Header="Flagged (UTC)" Binding="{Binding CreatedUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="170"
                                        FontFamily="{StaticResource CinderFontFamilyMono}" />
                    <DataGridTextColumn Header="By" Binding="{Binding Examiner}" Width="110" />
                    <DataGridTextColumn Header="Tool" Binding="{Binding Tool}" Width="120" />
                    <DataGridTextColumn Header="What" Binding="{Binding Title}" Width="2*" />
                    <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="2*" />
                    <DataGridTextColumn Header="Evidence" Binding="{Binding EvidencePath}" Width="*"
                                        FontFamily="{StaticResource CinderFontFamilyMono}" />
                </DataGrid.Columns>
            </DataGrid>
            <c:EmptyState Icon="{Binding IconGeometry}" Title="No bookmarks yet" IsVisible="{Binding !Bookmarks.Count}"
                          Message="When a row in any tool matters, select it and choose Bookmark. It is saved to the open case with your note, the tool and the evidence it came from, and appears here. Reports turns this list into numbered exhibits. Bookmarks need an open case." />
        </Panel>

        <Border Grid.Row="2" Classes="footer">
            <TextBlock Text="{Binding StatusLine}" />
        </Border>
    </Grid>
</UserControl>
