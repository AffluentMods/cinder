<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tools="using:Cinder.App.ViewModels.Tools"
             x:Class="Cinder.App.Views.Tools.VirusTotalView"
             x:DataType="tools:VirusTotalTool">
    <Grid RowDefinitions="Auto,Auto,*">
        <Border Grid.Row="0" Background="{DynamicResource CinderBackground1Brush}" Padding="14,10"
                BorderBrush="{DynamicResource CinderBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="120,*">
                <TextBlock Grid.Column="0" Text="API key" VerticalAlignment="Center"
                           Foreground="{DynamicResource CinderForegroundMutedBrush}" />
                <TextBox Grid.Column="1" Text="{Binding ApiKey}" PasswordChar="•"
                         Watermark="Paste your VT v3 key (kept in memory only)" />
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="{DynamicResource CinderBackground0Brush}" Padding="14,10">
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" Text="{Binding Hash}"
                         Watermark="MD5 / SHA-1 / SHA-256"
                         FontFamily="{DynamicResource CinderFontFamilyMono}">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Return" Command="{Binding LookupCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="1" Margin="6,0,0,0" Classes="accent" Content="Lookup"
                        Command="{Binding LookupCommand}" />
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="2" Padding="20" Background="{DynamicResource CinderBackground0Brush}">
            <SelectableTextBlock Text="{Binding ResultText, FallbackValue='Lookups are hash-only and never upload bytes. Opt-in.'}"
                                 FontFamily="{DynamicResource CinderFontFamilyMono}"
                                 FontSize="{DynamicResource CinderFontSizeSm}"
                                 Foreground="{DynamicResource CinderForegroundBrush}"
                                 TextWrapping="Wrap" />
        </ScrollViewer>
    </Grid>
</UserControl>
