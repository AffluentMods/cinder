<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Cinder.App.Controls"
             xmlns:tools="using:Cinder.App.ViewModels.Tools"
             x:Class="Cinder.App.Views.Tools.IocMatchView"
             x:DataType="tools:IocMatchTool">
    <!-- Two inputs in reading order — indicators, then where to look — then Run. -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

        <!-- ===== Toolbar ===== -->
        <Border Grid.Row="0" Height="44" Padding="14,0,12,0"
                BorderBrush="{DynamicResource CinderBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="tb" Command="{Binding PickIocListCommand}"
                            ToolTip.Tip="{Binding EvidencePath, TargetNullValue='A text file with one indicator per line: hashes, IPs, domains, paths, strings'}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:CinderIcon Data="{x:Static c:Icons.Target}" Width="14" Height="14" />
                            <TextBlock Text="{Binding EvidencePath, TargetNullValue='Indicator list…'}" VerticalAlignment="Center"
                                       MaxWidth="220" TextTrimming="PrefixCharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <c:CinderIcon Data="{x:Static c:Icons.Chevron}" Width="12" Height="12"
                                  Foreground="{DynamicResource CinderForegroundDisabledBrush}" />
                    <Button Classes="tb" Command="{Binding PickFolderCommand}"
                            ToolTip.Tip="{Binding TargetFolder, TargetNullValue='The folder to scan: a mounted image, a triage collection, an export'}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:CinderIcon Data="{x:Static c:Icons.Folder}" Width="14" Height="14" />
                            <TextBlock Text="{Binding TargetFolder, TargetNullValue='Folder to scan…'}" VerticalAlignment="Center"
                                       MaxWidth="260" TextTrimming="PrefixCharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <Button Classes="accent" Height="26" Padding="12,0" Content="Run scan"
                            Command="{Binding LoadEvidenceCommand}" CommandParameter="{Binding EvidencePath}"
                            IsEnabled="{Binding EvidencePath, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            IsVisible="{Binding Rows.Count}">
                    <Border Classes="field" Width="220" Height="28" Padding="9,0,8,0">
                        <Grid ColumnDefinitions="Auto,*">
                            <c:CinderIcon Data="{x:Static c:Icons.Filter}" Width="14" Height="14"
                                          Foreground="{DynamicResource CinderForegroundDisabledBrush}" />
                            <TextBox Grid.Column="1" Classes="bare" Margin="8,0,0,0" FontSize="12.5" Watermark="Filter hits"
                                     Text="{Binding RowFilter, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Border>
                    <Button Classes="tb">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:CinderIcon Data="{x:Static c:Icons.Download}" Width="14" Height="14" />
                            <TextBlock Text="Export" VerticalAlignment="Center" />
                            <c:CinderIcon Data="{x:Static c:Icons.ChevronDown}" Width="12" Height="12" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="CSV (formula-injection safe)" Command="{Binding ExportCommand}" CommandParameter="csv" />
                                <MenuItem Header="JSON array" Command="{Binding ExportCommand}" CommandParameter="json" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Indicator summary -->
        <Border Grid.Row="1" Padding="14,6" Background="{DynamicResource CinderSurface1Brush}"
                BorderBrush="{DynamicResource CinderBorderBrush}" BorderThickness="0,0,0,1"
                IsVisible="{Binding IndicatorSummary, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding IndicatorSummary}" Classes="muted" FontSize="12" />
        </Border>

        <Border Grid.Row="2" Padding="14,8"
                BorderBrush="{DynamicResource CinderDangerBrush}" BorderThickness="0,0,0,1"
                IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Border.Background>
                <SolidColorBrush Color="{DynamicResource CinderDangerColor}" Opacity="0.09" />
            </Border.Background>
            <SelectableTextBlock Text="{Binding ErrorMessage}" Classes="mono" TextWrapping="Wrap" FontSize="12" />
        </Border>

        <Border Grid.Row="3" IsVisible="{Binding IsTruncated}" Padding="14,8"
                Background="{DynamicResource CinderWarnSoftBrush}"
                BorderBrush="{DynamicResource CinderWarnBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*">
                <c:CinderIcon Data="{x:Static c:Icons.Alert}" Width="15" Height="15" VerticalAlignment="Top" Margin="0,1,10,0"
                              Foreground="{DynamicResource CinderWarnBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding StatusLine}" TextWrapping="Wrap" FontWeight="500" />
            </Grid>
        </Border>

        <Panel Grid.Row="4">
            <DataGrid ItemsSource="{Binding VisibleRows}" SelectedItem="{Binding SelectedRow}"
                      c:AutoColumns.FromFirstItem="True" IsReadOnly="True" IsVisible="{Binding Rows.Count}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Spacing="14"
                        IsVisible="{Binding !Rows.Count}">
                <Border Width="52" Height="52" CornerRadius="12" HorizontalAlignment="Center"
                        Background="{DynamicResource CinderSurface2Brush}"
                        BorderBrush="{DynamicResource CinderBorderStrongBrush}" BorderThickness="1">
                    <c:CinderIcon Data="{x:Static c:Icons.Target}" Width="24" Height="24"
                                  Foreground="{DynamicResource CinderAccentBrush}" />
                </Border>
                <TextBlock Text="Sweep for indicators" FontSize="18" FontWeight="600" HorizontalAlignment="Center" />
                <TextBlock Classes="muted" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                           Text="Pick an indicator list (one per line: file hashes, IPs, domains, paths, strings), then a folder. Cinder checks file hashes, paths and contents — ASCII and UTF-16 — and lists every hit." />
                <ProgressBar IsIndeterminate="True" Width="160" IsVisible="{Binding IsLoading}" HorizontalAlignment="Center" />
            </StackPanel>
        </Panel>

        <Border Grid.Row="5" Height="28" Padding="14,0" Background="{DynamicResource CinderSurface1Brush}"
                BorderBrush="{DynamicResource CinderBorderBrush}" BorderThickness="0,1,0,0"
                IsVisible="{Binding Rows.Count}">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="{Binding RowCountDisplay}" Classes="mono muted" FontSize="11.5" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding StatusLine}" Classes="dim" FontSize="11.5" Margin="16,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsTruncated}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
