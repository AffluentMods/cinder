<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tools="using:Cinder.App.ViewModels.Tools"
             x:Class="Cinder.App.Views.Tools.MountView"
             x:DataType="tools:MountTool">
    <ScrollViewer Padding="20" Background="{DynamicResource CinderBackground0Brush}">
        <StackPanel Spacing="14" MaxWidth="720">
            <Button Classes="accent" Content="Pick image + mount read-only…" Command="{Binding PickAndMountCommand}"
                    HorizontalAlignment="Left" />
            <TextBlock Text="{Binding ImagePath, FallbackValue='No image selected'}"
                       Foreground="{DynamicResource CinderForegroundMutedBrush}"
                       FontFamily="{DynamicResource CinderFontFamilyMono}" />
            <SelectableTextBlock Text="{Binding MountedAt}"
                                 FontFamily="{DynamicResource CinderFontFamilyMono}"
                                 IsVisible="{Binding MountedAt, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Text="{Binding StatusLine}"
                       Foreground="{DynamicResource CinderForegroundMutedBrush}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding StatusLine, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
