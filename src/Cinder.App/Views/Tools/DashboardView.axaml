<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cinder.App.ViewModels"
             xmlns:tools="using:Cinder.App.ViewModels.Tools"
             xmlns:c="using:Cinder.App.Controls"
             x:Class="Cinder.App.Views.Tools.DashboardView"
             x:DataType="tools:DashboardTool">
    <!--
        Home. A working surface, not a landing page: the three ways to start (with their
        shortcuts, so they are learned), what you touched last, and a short guide for people
        new to forensics. Accent is reserved for the one primary action.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="True">
        <Grid Margin="40,34,40,40" MaxWidth="1180" HorizontalAlignment="Left"
              ColumnDefinitions="*,40,340" RowDefinitions="Auto,28,Auto">

            <!-- ==================== Heading ==================== -->
            <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Viewbox Width="22" Height="22" VerticalAlignment="Center">
                        <Path Fill="{DynamicResource CinderAccentBrush}"
                              Data="M12 2 C13 6 18.5 8.2 18.5 14.2 A6.5 6.5 0 0 1 5.5 14.2 C5.5 11.2 7.3 9.1 8.5 7.2 C9.3 9.2 10.3 10.4 11.5 10.6 C10.6 7.6 11.1 4.6 12 2 Z" />
                    </Viewbox>
                    <TextBlock Text="Cinder" FontSize="22" FontWeight="600" LetterSpacing="-0.4" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="What remains tells the story." Classes="muted" FontSize="13.5" />
            </StackPanel>

            <!-- ==================== Left: start + recents ==================== -->
            <StackPanel Grid.Row="2" Grid.Column="0" Spacing="30">

                <!-- Start -->
                <StackPanel Spacing="6">
                    <TextBlock Text="START" Classes="section" Margin="0,0,0,4" />
                    <Button Classes="startrow" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CreateCaseCommand}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="starticon accent">
                                <c:CinderIcon Data="{x:Static c:Icons.Plus}" Foreground="{DynamicResource CinderOnAccentBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="New case" FontWeight="500" />
                                <TextBlock Text="A case keeps evidence, parsed results and a hash-chained custody log together."
                                           Classes="dim" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="2" Classes="kbd"><TextBlock Text="Ctrl N" /></Border>
                        </Grid>
                    </Button>
                    <Button Classes="startrow" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenCaseFromPickerCommand}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="starticon">
                                <c:CinderIcon Data="{x:Static c:Icons.Folder}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Open case…" FontWeight="500" />
                                <TextBlock Text="Pick up a .cinder case file where you left it." Classes="dim" FontSize="12" />
                            </StackPanel>
                            <Border Grid.Column="2" Classes="kbd"><TextBlock Text="Ctrl Shift O" /></Border>
                        </Grid>
                    </Button>
                    <Button Classes="startrow" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenFileCommand}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="starticon">
                                <c:CinderIcon Data="{x:Static c:Icons.Hex}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Open evidence without a case" FontWeight="500" />
                                <TextBlock Text="A quick look at one file in the hex viewer. Nothing is logged." Classes="dim" FontSize="12" />
                            </StackPanel>
                            <Border Grid.Column="2" Classes="kbd"><TextBlock Text="Ctrl O" /></Border>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Recent cases -->
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                        <TextBlock Text="RECENT CASES" Classes="section" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding RecentCases.Count}" Classes="mono dim" FontSize="10.5" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Classes="dim" FontSize="12.5" TextWrapping="Wrap"
                               IsVisible="{Binding !RecentCases.Count}"
                               Text="No cases yet. Cases you create or open appear here." />
                    <ItemsControl ItemsSource="{Binding RecentCases}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="tools:RecentCaseRow">
                                <Button Classes="recentrow" IsEnabled="{Binding CanReopen}" ToolTip.Tip="{Binding Path}"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ReopenRecentCaseCommand}"
                                        CommandParameter="{Binding}">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                        <c:CinderIcon Data="{x:Static c:Icons.Folder}" Width="14" Height="14"
                                                      Foreground="{DynamicResource CinderForegroundMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Examiner}" Classes="dim" FontSize="12"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding OpenedDisplay}" Classes="mono dim" FontSize="11.5"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Recent evidence -->
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                        <TextBlock Text="RECENT EVIDENCE" Classes="section" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding RecentEvidence.Count}" Classes="mono dim" FontSize="10.5" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Classes="dim" FontSize="12.5" TextWrapping="Wrap"
                               IsVisible="{Binding !RecentEvidence.Count}"
                               Text="Nothing opened yet. Press Ctrl+O, or drop a file on the hex viewer." />
                    <ItemsControl ItemsSource="{Binding RecentEvidence}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="tools:RecentEvidenceRow">
                                <Button Classes="recentrow" ToolTip.Tip="{Binding Path}"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ReopenRecentEvidenceCommand}"
                                        CommandParameter="{Binding}">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                        <c:CinderIcon Data="{x:Static c:Icons.Doc}" Width="14" Height="14"
                                                      Foreground="{DynamicResource CinderForegroundMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding FileName}" Classes="mono" FontSize="12.5"
                                                   Margin="10,0,12,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Path}" Classes="mono dim" FontSize="11.5"
                                                   VerticalAlignment="Center" TextTrimming="PrefixCharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding OpenedDisplay}" Classes="mono dim" FontSize="11.5"
                                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <!-- ==================== Right: first-time guide ==================== -->
            <StackPanel Grid.Row="2" Grid.Column="2" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                    <TextBlock Text="NEW TO FORENSICS?" Classes="section" VerticalAlignment="Center" />
                </StackPanel>
                <Border Background="{DynamicResource CinderSurface2Brush}" CornerRadius="8" Padding="4,6">
                    <ItemsControl ItemsSource="{Binding Guide}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="tools:GuideStep">
                                <Grid ColumnDefinitions="28,*" Margin="10,8,12,8">
                                    <TextBlock Text="{Binding Number}" Classes="mono" FontSize="12"
                                               Foreground="{DynamicResource CinderAccentBrush}" Margin="0,1,0,0" />
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="{Binding Title}" FontWeight="500" FontSize="13" />
                                        <TextBlock Text="{Binding Body}" Classes="muted" FontSize="12" LineHeight="17" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <Grid ColumnDefinitions="Auto,*" Margin="2,10,0,0">
                    <c:CinderIcon Data="{x:Static c:Icons.Help}" Width="15" Height="15" VerticalAlignment="Top" Margin="0,1,0,0"
                                  Foreground="{DynamicResource CinderForegroundMutedBrush}" />
                    <TextBlock Grid.Column="1" Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="10,0,0,0" LineHeight="17">
                        <Run Text="Every tool explains itself. Press" />
                        <Run Text="F1" FontFamily="{DynamicResource CinderFontFamilyMono}" Foreground="{DynamicResource CinderForegroundBrush}" />
                        <Run Text="or the ? in its header: what the artefact is, when an examiner uses it, and how to read Cinder's view of it." />
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>

    <UserControl.Styles>
        <Style Selector="Button.startrow">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="54" />
            <Setter Property="Padding" Value="10,0,12,0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.startrow:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CinderSurface2Brush}" />
        </Style>
        <Style Selector="Border.starticon">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource CinderSurface2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CinderBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.starticon.accent">
            <Setter Property="Background" Value="{DynamicResource CinderAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Border.starticon > c|CinderIcon">
            <Setter Property="Width" Value="17" />
            <Setter Property="Height" Value="17" />
        </Style>
        <Style Selector="Button.recentrow">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.recentrow:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CinderSurface2Brush}" />
        </Style>
    </UserControl.Styles>
</UserControl>
