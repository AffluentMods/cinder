<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Cinder.App.Controls"
             xmlns:tools="using:Cinder.App.ViewModels.Tools"
             x:Class="Cinder.App.Views.Tools.StringsView"
             x:DataType="tools:StringsTool">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Primary action bar -->
        <Border Grid.Row="0" Classes="toolbar">
            <Grid ColumnDefinitions="Auto,*">
                <Button Classes="tb" VerticalAlignment="Center" Command="{Binding PickCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:CinderIcon Data="{x:Static c:Icons.Folder}" Width="14" Height="14" />
                        <TextBlock Text="Pick file…" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="1" Classes="path" Margin="14,0" Text="{Binding Path}"
                           ToolTip.Tip="{Binding Path}" />
            </Grid>
        </Border>

        <!-- Filter + options row (only when a file is loaded) -->
        <Border Grid.Row="1" Classes="subbar"
                IsVisible="{Binding Path, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto">
                    <!-- Mode first: "Contains text" / "Regex" / a feature preset such as
                         Email addresses or Payment card numbers. With a preset selected the
                         text box narrows within that preset. -->
                    <ComboBox Grid.Column="0" Margin="0,0,8,0" Width="210"
                              ItemsSource="{Binding FilterModes}"
                              SelectedItem="{Binding FilterMode}"
                              ToolTip.Tip="{Binding FilterMode.Description}" />
                    <TextBox Grid.Column="1"
                             Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                             Watermark="Type to narrow the list"
                             FontSize="{DynamicResource CinderFontSizeSm}" />
                    <CheckBox Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center"
                              IsChecked="{Binding HideGibberish}"
                              Content="Hide gibberish"
                              ToolTip.Tip="Hide short runs that are almost certainly chance, such as letters that happen to occur inside compressed data." />
                    <TextBlock Grid.Column="3" Margin="14,0,8,0" VerticalAlignment="Center"
                               Text="Min length"
                               FontSize="{DynamicResource CinderFontSizeXs}"
                               Foreground="{DynamicResource CinderForegroundMutedBrush}" />
                    <NumericUpDown Grid.Column="4"
                                   Value="{Binding MinLength}"
                                   Minimum="3" Maximum="32" Increment="1"
                                   Width="100"
                                   FormatString="0" />
                    <Button Grid.Column="5" Classes="tb" Margin="8,0,0,0" Content="Scan again" Command="{Binding RunCommand}"
                            ToolTip.Tip="Run the scan again with the current minimum length" />
                    <c:ExportButton Grid.Column="6" Margin="8,0,0,0" ExportCommand="{Binding ExportCommand}"
                                    IsVisible="{Binding Hits.Count}" />
                </Grid>
                <TextBlock Text="{Binding FilterError}"
                           Foreground="{DynamicResource CinderDangerBrush}"
                           FontSize="{DynamicResource CinderFontSizeXs}"
                           IsVisible="{Binding FilterError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </Border>

        <Panel Grid.Row="2">
            <!-- Empty state -->
            <c:EmptyState Icon="{x:Static c:Icons.Text}" Title="Find the readable text in any file"
                          IsVisible="{Binding Path, Converter={x:Static ObjectConverters.IsNull}}"
                          Message="Pulls out every run of readable characters: user names, web addresses, file paths, error messages, commands. It works on anything, including programs, memory dumps and disk images, and is often the fastest way to see what a file is about.">
                <Button Classes="accent" Height="30" Padding="14,0" Content="Pick file…" Command="{Binding PickCommand}" />
            </c:EmptyState>

            <!-- Populated state -->
            <Grid IsVisible="{Binding Path, Converter={x:Static ObjectConverters.IsNotNull}}"
                  RowDefinitions="Auto,*">

                <!-- Shown when the file is a ZIP / gzip / similar: its strings are compressed away. -->
                <Border Grid.Row="0" Padding="14,8" Background="{DynamicResource CinderWarnSoftBrush}"
                        BorderBrush="{DynamicResource CinderWarnBrush}" BorderThickness="0,0,0,1"
                        IsVisible="{Binding ContainerHint, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Grid ColumnDefinitions="Auto,*">
                        <c:CinderIcon Data="{x:Static c:Icons.Alert}" Width="15" Height="15" VerticalAlignment="Top" Margin="0,1,10,0"
                                      Foreground="{DynamicResource CinderWarnBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding ContainerHint}" TextWrapping="Wrap" FontSize="12.5" />
                    </Grid>
                </Border>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Hits}" AutoGenerateColumns="False" IsReadOnly="True"
                          DoubleTapped="OnHitDoubleTapped">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Offset" Binding="{Binding Offset, StringFormat='0x{0:X12}'}" Width="150"
                                            FontFamily="{StaticResource CinderFontFamilyMono}" />
                        <DataGridTextColumn Header="Encoding" Binding="{Binding Encoding}" Width="100" />
                        <DataGridTextColumn Header="Text" Binding="{Binding Value}" Width="*"
                                            FontFamily="{StaticResource CinderFontFamilyMono}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Panel>

        <Border Grid.Row="3" Classes="footer" IsVisible="{Binding Path, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="{Binding Hits.Count, StringFormat='{}{0:N0} shown'}" Classes="mono" />
                <TextBlock Grid.Column="1" Text="{Binding StatusLine}" Margin="16,0,0,0" />
                <TextBlock Grid.Column="2" Text="Double-click a row to see it in the Hex Viewer" IsVisible="{Binding Hits.Count}"
                           Foreground="{DynamicResource CinderForegroundDisabledBrush}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
