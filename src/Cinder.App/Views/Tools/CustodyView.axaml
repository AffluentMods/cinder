<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tools="using:Cinder.App.ViewModels.Tools"
             xmlns:c="using:Cinder.Core.Custody"
             x:Class="Cinder.App.Views.Tools.CustodyView"
             x:DataType="tools:CustodyTool">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Border Grid.Row="0" Background="{DynamicResource CinderBackground1Brush}" Padding="14,10"
                BorderBrush="{DynamicResource CinderBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Content="Open + verify…" Classes="accent"
                        Command="{Binding PickAndVerifyCommand}" />
                <TextBlock Grid.Column="1" Margin="14,0" VerticalAlignment="Center"
                           Text="{Binding CasePath, FallbackValue='No case loaded'}"
                           Foreground="{DynamicResource CinderForegroundMutedBrush}" />
                <TextBlock Grid.Column="2" Text="{Binding Verdict}"
                           Foreground="{DynamicResource CinderAccentBrush}"
                           VerticalAlignment="Center"
                           IsVisible="{Binding Verdict, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </Grid>
        </Border>

        <!-- Attestations: the anchor outside the file. The chain above re-verifies after a
             consistent rewrite; a signed tip does not. -->
        <Border Grid.Row="1" Background="{DynamicResource CinderSurface1Brush}" Padding="14,8"
                BorderBrush="{DynamicResource CinderBorderBrush}" BorderThickness="0,0,0,1"
                IsVisible="{Binding CasePath, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <Button Grid.Column="0" Content="Sign chain tip" Command="{Binding SignTipCommand}"
                        ToolTip.Tip="Signs the current tip (sequence + hash) with the examiner key in your profile. A later rewrite of the log then fails attestation even if the chain re-verifies." />
                <Button Grid.Column="1" Margin="6,0,0,0" Content="Export attestation…" Command="{Binding ExportAttestationCommand}"
                        ToolTip.Tip="Self-contained JSON with the public key and signature. Send it somewhere you cannot later edit." />
                <TextBlock Grid.Column="2" Margin="14,0" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="{Binding AttestationVerdict}"
                           FontSize="{DynamicResource CinderFontSizeSm}"
                           Foreground="{DynamicResource CinderForegroundBrush}" />
                <TextBlock Grid.Column="3" VerticalAlignment="Center" Classes="mono"
                           Text="{Binding KeyFingerprint, StringFormat='key {0}'}"
                           FontSize="{DynamicResource CinderFontSizeXs}"
                           Foreground="{DynamicResource CinderForegroundMutedBrush}"
                           IsVisible="{Binding KeyFingerprint, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </Grid>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Entries}" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="{DynamicResource CinderBackground0Brush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Seq"        Binding="{Binding Sequence}" Width="60" />
                <DataGridTextColumn Header="Timestamp"  Binding="{Binding TimestampUtc, StringFormat=u}" Width="200" />
                <DataGridTextColumn Header="Examiner"   Binding="{Binding Examiner}" Width="120" />
                <DataGridTextColumn Header="Action"     Binding="{Binding Action}"   Width="160" />
                <DataGridTextColumn Header="Details"    Binding="{Binding DetailsJson}" Width="*" />
                <DataGridTextColumn Header="Hash"       Binding="{Binding EntryHash}" Width="180" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="{DynamicResource CinderSurface1Brush}" Padding="14,4">
            <TextBlock Text="{Binding StatusLine}" TextWrapping="Wrap"
                       FontSize="{DynamicResource CinderFontSizeXs}"
                       Foreground="{DynamicResource CinderForegroundMutedBrush}"
                       IsVisible="{Binding StatusLine, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </Border>
    </Grid>
</UserControl>
