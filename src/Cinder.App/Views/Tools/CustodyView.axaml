<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Cinder.App.Controls"
             xmlns:tools="using:Cinder.App.ViewModels.Tools"
             x:Class="Cinder.App.Views.Tools.CustodyView"
             x:DataType="tools:CustodyTool">
    <!-- Pick a case file (or use the open one); Cinder re-checks its log and says intact or altered. -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <Border Grid.Row="0" Classes="toolbar">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="tb" Command="{Binding VerifyOpenCaseCommand}" IsVisible="{Binding HasOpenCase}"
                            ToolTip.Tip="Re-check the log of the case shown in the title bar">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:CinderIcon Data="{x:Static c:Icons.Check}" Width="14" Height="14" />
                            <TextBlock Text="Check the open case" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tb" Content="Check a case file…" Command="{Binding PickAndVerifyCommand}"
                            ToolTip.Tip="Pick any .cinder file, including one sent to you by another examiner" />
                </StackPanel>
                <TextBlock Grid.Column="1" Classes="path" Margin="14,0" Text="{Binding CasePath}" ToolTip.Tip="{Binding CasePath}" />
                <c:ExportButton Grid.Column="2" ExportCommand="{Binding ExportCommand}" VerticalAlignment="Center"
                                IsVisible="{Binding Entries.Count}" />
            </Grid>
        </Border>

        <!-- The verdict: the one thing this screen exists to say. -->
        <Border Grid.Row="1" Padding="14,10" BorderBrush="{DynamicResource CinderBorderBrush}" BorderThickness="0,0,0,1"
                IsVisible="{Binding Verdict, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid ColumnDefinitions="Auto,*">
                <Ellipse Classes="status-dot muted" Classes.ok="{Binding VerdictIsOk}" Classes.danger="{Binding VerdictIsBroken}"
                         Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,10,0" />
                <SelectableTextBlock Grid.Column="1" Text="{Binding Verdict}" FontSize="13" FontWeight="500" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- Signatures: the anchor outside the file. A consistent rewrite passes the chain check; a signed tip does not. -->
        <Border Grid.Row="2" Classes="subbar" IsVisible="{Binding HasCaseFile}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <Button Grid.Column="0" Classes="tb" Content="Sign the log" Command="{Binding SignTipCommand}"
                        ToolTip.Tip="Signs the latest entry with your examiner key. If someone later rewrites the whole log, the signature no longer matches." />
                <Button Grid.Column="1" Classes="tb" Margin="6,0,0,0" Content="Export signature…" Command="{Binding ExportAttestationCommand}"
                        ToolTip.Tip="Saves the signature and your public key to a file. Send it somewhere you cannot edit afterwards." />
                <TextBlock Grid.Column="2" Margin="14,0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12.5"
                           Text="{Binding AttestationVerdict}" />
                <TextBlock Grid.Column="3" Classes="mono dim" FontSize="11.5" VerticalAlignment="Center"
                           Text="{Binding KeyFingerprint, StringFormat='your key {0}'}"
                           IsVisible="{Binding KeyFingerprint, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </Grid>
        </Border>

        <Panel Grid.Row="3">
            <DataGrid ItemsSource="{Binding Entries}" AutoGenerateColumns="False" IsReadOnly="True" IsVisible="{Binding Entries.Count}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="64"
                                        FontFamily="{StaticResource CinderFontFamilyMono}" />
                    <DataGridTextColumn Header="Time (UTC)" Binding="{Binding TimestampUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="170"
                                        FontFamily="{StaticResource CinderFontFamilyMono}" />
                    <DataGridTextColumn Header="Examiner" Binding="{Binding Examiner}" Width="130" />
                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="150" />
                    <DataGridTextColumn Header="Details" Binding="{Binding DetailsJson}" Width="*"
                                        FontFamily="{StaticResource CinderFontFamilyMono}" />
                    <DataGridTextColumn Header="Entry hash" Binding="{Binding EntryHash}" Width="180"
                                        FontFamily="{StaticResource CinderFontFamilyMono}" />
                </DataGrid.Columns>
            </DataGrid>
            <c:EmptyState Icon="{Binding IconGeometry}" Title="Check that a case log has not been altered"
                          IsVisible="{Binding !Entries.Count}"
                          Message="Every action in a case is written to a log in which each entry is locked to the one before it. Cinder re-computes that chain here: if an entry was changed, removed or reordered after it was written, the check fails and names the entry.">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="accent" Height="30" Padding="14,0" Content="Check the open case"
                            Command="{Binding VerifyOpenCaseCommand}" IsVisible="{Binding HasOpenCase}" />
                    <Button Classes="tb" Height="30" Padding="14,0" Content="Check a case file…" Command="{Binding PickAndVerifyCommand}"
                            IsVisible="{Binding HasOpenCase}" />
                    <Button Classes="accent" Height="30" Padding="14,0" Content="Check a case file…" Command="{Binding PickAndVerifyCommand}"
                            IsVisible="{Binding !HasOpenCase}" />
                </StackPanel>
            </c:EmptyState>
        </Panel>

        <Border Grid.Row="4" Classes="footer">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="{Binding Entries.Count, StringFormat='{}{0:N0} entries'}" Classes="mono" IsVisible="{Binding Entries.Count}" />
                <TextBlock Grid.Column="1" Text="{Binding StatusLine}" Margin="16,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
