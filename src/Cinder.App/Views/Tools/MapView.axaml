<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Cinder.App.Controls"
             xmlns:tools="using:Cinder.App.ViewModels.Tools"
             x:Class="Cinder.App.Views.Tools.MapView"
             x:DataType="tools:MapTool">
    <!-- A location list: fill it from photo EXIF or by hand, then export it to a mapping tool. -->
    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <Border Grid.Row="0" Classes="toolbar">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="tb" Command="{Binding IngestPhotosCommand}"
                            ToolTip.Tip="Reads the GPS position stored in each photo under a folder (subfolders included)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:CinderIcon Data="{x:Static c:Icons.Image}" Width="14" Height="14" />
                            <TextBlock Text="Add photos from folder…" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tb" Content="Stop" Command="{Binding IngestPhotosCancelCommand}"
                            IsVisible="{Binding IngestPhotosCommand.IsRunning}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            IsVisible="{Binding Points.Count}">
                    <c:ExportButton ExportCommand="{Binding ExportCommand}" Formats="csv,json,kml" />
                    <Button Classes="tb" Content="Clear" Command="{Binding ClearCommand}"
                            ToolTip.Tip="Remove every point from this list (the photos are not touched)" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="subbar">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Add a point" Classes="label" Margin="0,0,4,0" />
                <TextBox Width="120" Text="{Binding Latitude}" Watermark="Latitude" ToolTip.Tip="Decimal degrees, north positive (-90 to 90)"
                         FontFamily="{DynamicResource CinderFontFamilyMono}" />
                <TextBox Width="120" Text="{Binding Longitude}" Watermark="Longitude" ToolTip.Tip="Decimal degrees, east positive (-180 to 180)"
                         FontFamily="{DynamicResource CinderFontFamilyMono}" />
                <TextBox Width="220" Text="{Binding Label}" Watermark="What is at this location" />
                <TextBox Width="140" Text="{Binding Source}" Watermark="Where it came from" />
                <Button Classes="tb" Content="Add" Command="{Binding AddPointCommand}" />
            </StackPanel>
        </Border>

        <Panel Grid.Row="2">
            <DataGrid ItemsSource="{Binding Points}" AutoGenerateColumns="False" IsReadOnly="True"
                      IsVisible="{Binding Points.Count}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Latitude" Binding="{Binding Latitude, StringFormat=F6}" Width="120"
                                        FontFamily="{StaticResource CinderFontFamilyMono}" />
                    <DataGridTextColumn Header="Longitude" Binding="{Binding Longitude, StringFormat=F6}" Width="120"
                                        FontFamily="{StaticResource CinderFontFamilyMono}" />
                    <DataGridTextColumn Header="Time" Binding="{Binding TimeDisplay}" Width="230"
                                        FontFamily="{StaticResource CinderFontFamilyMono}" />
                    <DataGridTextColumn Header="Time from" Binding="{Binding TimeSource}" Width="140" />
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="110" />
                    <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <c:EmptyState Icon="{Binding IconGeometry}" Title="No locations yet" IsVisible="{Binding !Points.Count}"
                          Message="Point Cinder at a folder of photos and it lists every one that carries a GPS position, with the time the camera recorded. Export the list as KML to see it on a map in Google Earth or QGIS.">
                <Button Classes="accent" Height="30" Padding="14,0" Content="Add photos from folder…"
                        Command="{Binding IngestPhotosCommand}" />
            </c:EmptyState>
        </Panel>

        <Border Grid.Row="3" Classes="footer">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="{Binding Points.Count, StringFormat='{}{0:N0} points'}" Classes="mono" />
                <TextBlock Grid.Column="1" Text="{Binding StatusLine}" Margin="16,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
