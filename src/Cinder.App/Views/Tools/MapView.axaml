<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tools="using:Cinder.App.ViewModels.Tools"
             xmlns:srch="using:Cinder.Search"
             x:Class="Cinder.App.Views.Tools.MapView"
             x:DataType="tools:MapTool">
    <Grid RowDefinitions="Auto,Auto,*">
        <Border Grid.Row="0" Background="{DynamicResource CinderBackground1Brush}" Padding="14,10"
                BorderBrush="{DynamicResource CinderBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Classes="accent" Content="Ingest photos…"
                        Command="{Binding IngestPhotosCommand}"
                        ToolTip.Tip="Walk a folder of images, extract GPS coordinates from EXIF, add every geo-tagged photo as a point." />
                <TextBlock Text="{Binding StatusLine}" VerticalAlignment="Center"
                           FontSize="{DynamicResource CinderFontSizeXs}"
                           Foreground="{DynamicResource CinderForegroundMutedBrush}" />
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="{DynamicResource CinderSurface1Brush}" Padding="14,8"
                BorderBrush="{DynamicResource CinderBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Add manually:" VerticalAlignment="Center"
                           FontSize="{DynamicResource CinderFontSizeXs}"
                           Foreground="{DynamicResource CinderForegroundMutedBrush}" />
                <TextBox Width="110" Text="{Binding Latitude}" Watermark="lat" />
                <TextBox Width="110" Text="{Binding Longitude}" Watermark="lng" />
                <TextBox Width="180" Text="{Binding Label}" Watermark="label" />
                <TextBox Width="120" Text="{Binding Source}" Watermark="source" />
                <Button Content="Add point" Command="{Binding AddPointCommand}" />
                <Button Content="Clear all" Command="{Binding ClearCommand}" />
            </StackPanel>
        </Border>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Points}" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="{DynamicResource CinderBackground0Brush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Latitude"  Binding="{Binding Latitude, StringFormat=F5}"  Width="120" />
                <DataGridTextColumn Header="Longitude" Binding="{Binding Longitude, StringFormat=F5}" Width="120" />
                <DataGridTextColumn Header="Source"    Binding="{Binding Source}" Width="160" />
                <DataGridTextColumn Header="Label"     Binding="{Binding Label}"  Width="*" />
                <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat=u}" Width="200" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
