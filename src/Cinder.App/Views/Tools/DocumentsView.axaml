<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Cinder.App.Controls"
             xmlns:tools="using:Cinder.App.ViewModels.Tools"
             x:Class="Cinder.App.Views.Tools.DocumentsView"
             x:DataType="tools:DocumentsTool">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Classes="toolbar" IsVisible="{Binding Path, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Classes="tb" VerticalAlignment="Center" Command="{Binding PickCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:CinderIcon Data="{x:Static c:Icons.Doc}" Width="14" Height="14" />
                        <TextBlock Text="Pick document…" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="1" Classes="path" Margin="14,0" Text="{Binding Path}"
                           ToolTip.Tip="{Binding Path}" />
                <TextBlock Grid.Column="2" Text="{Binding StatusLine}" Classes="dim" FontSize="11.5" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <Panel Grid.Row="1" Background="{DynamicResource CinderBackground0Brush}">
            <c:EmptyState Icon="{x:Static c:Icons.Doc}" Title="Read a document without opening it"
                          IsVisible="{Binding Path, Converter={x:Static ObjectConverters.IsNull}}"
                          Message="Shows the text inside a PDF, Word, Excel, PowerPoint, OpenDocument, EPUB or RTF file without starting Office or a PDF reader, so nothing in the document can run. Text only: no layout, pictures or document properties.">
                <Button Classes="accent" Height="30" Padding="14,0" Content="Pick document…" Command="{Binding PickCommand}" />
            </c:EmptyState>

            <ScrollViewer Padding="20"
                          IsVisible="{Binding Path, Converter={x:Static ObjectConverters.IsNotNull}}">
                <SelectableTextBlock Text="{Binding Content, FallbackValue=''}"
                                     FontFamily="{DynamicResource CinderFontFamilyMono}"
                                     FontSize="{DynamicResource CinderFontSizeSm}"
                                     Foreground="{DynamicResource CinderForegroundBrush}"
                                     TextWrapping="Wrap" />
            </ScrollViewer>
        </Panel>
    </Grid>
</UserControl>
