<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tools="using:Cinder.App.ViewModels.Tools"
             x:Class="Cinder.App.Views.Tools.DocumentsView"
             x:DataType="tools:DocumentsTool">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="{DynamicResource CinderBackground1Brush}" Padding="14,10"
                BorderBrush="{DynamicResource CinderBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Content="Pick document…" Classes="accent" Command="{Binding PickCommand}" />
                <TextBlock Grid.Column="1" Margin="14,0" VerticalAlignment="Center"
                           Text="{Binding Path, FallbackValue='No document loaded'}"
                           Foreground="{DynamicResource CinderForegroundMutedBrush}" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                           Text="{Binding StatusLine}"
                           FontSize="{DynamicResource CinderFontSizeXs}"
                           Foreground="{DynamicResource CinderForegroundMutedBrush}" />
            </Grid>
        </Border>
        <Panel Grid.Row="1" Background="{DynamicResource CinderBackground0Brush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="14" MaxWidth="460"
                        IsVisible="{Binding Path, Converter={x:Static ObjectConverters.IsNull}}">
                <Border Width="64" Height="64" CornerRadius="8"
                        Background="{DynamicResource CinderSurface3Brush}"
                        BorderBrush="{DynamicResource CinderBorderBrush}" BorderThickness="1"
                        HorizontalAlignment="Center">
                    <TextBlock Text="📄" FontSize="32"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="No document loaded"
                           FontSize="{DynamicResource CinderFontSizeXl}" FontWeight="600"
                           LetterSpacing="-0.4"
                           Foreground="{DynamicResource CinderForegroundBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock TextAlignment="Center" TextWrapping="Wrap"
                           FontSize="{DynamicResource CinderFontSizeSm}"
                           Foreground="{DynamicResource CinderForegroundMutedBrush}"
                           Text="Preview a PDF, Word, Excel, RTF, or ODF document without launching Office or Acrobat. Cinder also surfaces hidden metadata: original author, revisions, embedded files, unresolved comments." />
                <Button Classes="accent" Content="Pick document…"
                        Command="{Binding PickCommand}"
                        HorizontalAlignment="Center" Padding="20,10" />
            </StackPanel>

            <ScrollViewer Padding="20"
                          IsVisible="{Binding Path, Converter={x:Static ObjectConverters.IsNotNull}}">
                <SelectableTextBlock Text="{Binding Content, FallbackValue=''}"
                                     FontFamily="{DynamicResource CinderFontFamilyMono}"
                                     FontSize="{DynamicResource CinderFontSizeSm}"
                                     Foreground="{DynamicResource CinderForegroundBrush}"
                                     TextWrapping="Wrap" />
            </ScrollViewer>
        </Panel>
    </Grid>
</UserControl>
