<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tools="using:Cinder.App.ViewModels.Tools"
             x:Class="Cinder.App.Views.Tools.RamCaptureView"
             x:DataType="tools:RamCaptureTool">
    <ScrollViewer Padding="20" Background="{DynamicResource CinderBackground0Brush}">
        <StackPanel Spacing="14" MaxWidth="720">
            <Button Classes="accent" Content="Pick output + capture…" Command="{Binding PickAndCaptureCommand}"
                    HorizontalAlignment="Left" />
            <TextBlock Text="{Binding Output, FallbackValue='No output path selected'}"
                       Foreground="{DynamicResource CinderForegroundMutedBrush}"
                       FontFamily="{DynamicResource CinderFontFamilyMono}" />
            <TextBlock Text="{Binding StatusLine}"
                       Foreground="{DynamicResource CinderForegroundMutedBrush}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding StatusLine, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
