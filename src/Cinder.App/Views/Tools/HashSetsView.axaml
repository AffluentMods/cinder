<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Cinder.App.Controls"
             xmlns:tools="using:Cinder.App.ViewModels.Tools"
             x:Class="Cinder.App.Views.Tools.HashSetsView"
             x:DataType="tools:HashSetsTool">
    <!-- Open a hash set, then check a hash against it. -->
    <Grid RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0" Classes="toolbar">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="tb" Content="Open hash set…" Command="{Binding PickDatabaseCommand}"
                            ToolTip.Tip="Open a hash-set database (.db) you created earlier" />
                    <Button Classes="tb" Content="New hash set…" Command="{Binding NewDatabaseCommand}"
                            ToolTip.Tip="Create an empty hash-set database, then import a list into it" />
                </StackPanel>
                <TextBlock Grid.Column="1" Classes="path" Margin="14,0" Text="{Binding DatabasePath}"
                           ToolTip.Tip="{Binding DatabasePath}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            IsVisible="{Binding HasDatabase}">
                    <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding ImportNsrlCommand.IsRunning}" />
                    <Button Classes="tb" Content="Import NSRL list…" Command="{Binding ImportNsrlCommand}"
                            ToolTip.Tip="Add the hashes from an NSRL minimal CSV (NSRLFile.txt) to this hash set" />
                </StackPanel>
            </Grid>
        </Border>

        <Panel Grid.Row="1">
            <ScrollViewer IsVisible="{Binding HasDatabase}" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,24" MaxWidth="760" HorizontalAlignment="Left" Spacing="16">
                    <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap" LineHeight="19" MaxWidth="640" HorizontalAlignment="Left"
                               Text="Paste a file hash to see whether it is in this hash set. A match on a known-good list (such as NSRL) means the file is standard software you can usually set aside; a match on your own known-bad list means it needs attention." />
                    <Grid ColumnDefinitions="120,Auto,*,Auto">
                        <TextBlock Text="Hash" Classes="label" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Algorithms}" SelectedItem="{Binding Algorithm}" MinWidth="104" />
                        <TextBox Grid.Column="2" Margin="6,0" Text="{Binding Query}" Watermark="Paste the hash (hex)"
                                 FontFamily="{DynamicResource CinderFontFamilyMono}">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Return" Command="{Binding LookupCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="3" Classes="accent" Height="30" Padding="14,0" Content="Look up"
                                Command="{Binding LookupCommand}" />
                    </Grid>
                    <Border Background="{DynamicResource CinderSurface2Brush}" CornerRadius="8" Padding="16,14" Margin="120,0,0,0"
                            IsVisible="{Binding VerdictLine, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <SelectableTextBlock Text="{Binding VerdictLine}" FontSize="13" TextWrapping="Wrap" LineHeight="19" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <c:EmptyState Icon="{Binding IconGeometry}" Title="No hash set open" IsVisible="{Binding !HasDatabase}"
                          Message="A hash set is a list of file hashes you already know about: the NSRL list of standard software, or your own list of known-bad files. Open one to check a hash against it. The Filesystem tool uses the same hash set to mark files as known.">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="accent" Height="30" Padding="14,0" Content="Open hash set…" Command="{Binding PickDatabaseCommand}" />
                    <Button Classes="tb" Height="30" Padding="14,0" Content="New hash set…" Command="{Binding NewDatabaseCommand}" />
                </StackPanel>
            </c:EmptyState>
        </Panel>

        <Border Grid.Row="2" Classes="footer">
            <TextBlock Text="{Binding StatusLine}" />
        </Border>
    </Grid>
</UserControl>
