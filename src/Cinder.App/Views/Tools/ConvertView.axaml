<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tools="using:Cinder.App.ViewModels.Tools"
             xmlns:c="using:Cinder.App.Controls"
             x:Class="Cinder.App.Views.Tools.ConvertView"
             x:DataType="tools:ConvertTool">
    <!-- Task page: the inputs and the one action on the left; what it does, then its progress
         and result, on the right. -->
    <c:TaskPage>
        <StackPanel Spacing="18">
            <StackPanel>
                <TextBlock Classes="field-label" Text="Image to convert" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Text="{Binding Source}" Watermark="Raw, E01, AFF4, VHD or VHDX"
                             FontFamily="{DynamicResource CinderFontFamilyMono}" />
                    <Button Grid.Column="1" Classes="tb" Margin="6,0,0,0" Height="28" Content="Pick…" Command="{Binding PickSourceCommand}" />
                </Grid>
            </StackPanel>
            <StackPanel>
                <TextBlock Classes="field-label" Text="Save the copy as" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Text="{Binding Output}" Watermark="A new file"
                             FontFamily="{DynamicResource CinderFontFamilyMono}" />
                    <Button Grid.Column="1" Classes="tb" Margin="6,0,0,0" Height="28" Content="Save as…" Command="{Binding PickOutputCommand}" />
                </Grid>
            </StackPanel>
            <StackPanel>
                <TextBlock Classes="field-label" Text="Format of the copy" />
                <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}" MinWidth="160" />
            </StackPanel>
            <CheckBox IsChecked="{Binding Overwrite}" Content="Replace an existing image at this path"
                      ToolTip.Tip="Off by default. Without it, converting refuses to start if a file is already there, including what is left of an earlier failed run." />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                <Button Classes="accent" Height="30" Padding="14,0" Command="{Binding RunCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:CinderIcon Data="{x:Static c:Icons.Swap}" Width="15" Height="15" />
                        <TextBlock Text="Convert image" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="tb" Height="30" Padding="12,0" Content="Stop converting"
                        Command="{Binding RunCancelCommand}" IsVisible="{Binding RunCommand.IsRunning}"
                        ToolTip.Tip="Stops and deletes the unfinished output" />
            </StackPanel>
        </StackPanel>

        <c:TaskPage.Aside>
            <StackPanel>
                <StackPanel IsVisible="{Binding StatusLine, Converter={x:Static ObjectConverters.IsNull}}">
                    <TextBlock Classes="section" Text="WHAT HAPPENS" Margin="0,0,0,14" />
                    <c:Step Number="1" Title="Reads the image in whatever format it is in"
                            Text="Raw, E01, AFF4, VHD and VHDX can each be turned into any of the others. The source is opened read-only and is not changed." />
                    <c:Step Number="2" Title="Writes the same disk content in the new format"
                            Text="The copy appears under its final name only once it is complete." />
                    <c:Step Number="3" Title="Checks the copy"
                            Text="The new file is read back and must hash to exactly what was written. The result is reported as the output check." />
                    <c:Step Number="4" Title="Checks the source, where it can"
                            Text="An E01 or AFF4 source carries the hash recorded when it was acquired, and is checked against it. A raw, VHD or VHDX source carries none, so that check is reported as not possible rather than passed." />
                </StackPanel>

                <StackPanel Spacing="12" IsVisible="{Binding StatusLine, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Classes="section" Text="RESULT" />
                    <StackPanel Spacing="8" IsVisible="{Binding RunCommand.IsRunning}">
                        <ProgressBar IsIndeterminate="True" />
                        <TextBlock Text="{Binding BytesConverted, StringFormat='{}{0:N0} bytes converted so far'}" Classes="mono dim" FontSize="12" />
                    </StackPanel>
                    <Border Classes="result">
                        <SelectableTextBlock Text="{Binding StatusLine}" TextWrapping="Wrap" FontSize="12.5" LineHeight="19" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </c:TaskPage.Aside>
    </c:TaskPage>
</UserControl>
