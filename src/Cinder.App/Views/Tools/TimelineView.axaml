<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cinder.App.ViewModels"
             xmlns:c="using:Cinder.App.Controls"
             x:Class="Cinder.App.Views.Tools.TimelineView"
             x:DataType="vm:TimelineToolViewModel">
    <!--
        Super-timeline. Toolbar: get events in (ingest) · act on them (bookmark, export).
        Filter bar wraps instead of colliding with the toolbar at narrow widths. Filters apply on
        Enter or Refresh, and Export writes what the applied filter matches. Histogram shows
        where the activity is; the grid is the first 5,000 matching events.
    -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- ===== Toolbar ===== -->
        <Border Grid.Row="0" Height="44" Padding="14,0,12,0"
                BorderBrush="{DynamicResource CinderBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="accent" Height="26" Padding="10,0" Command="{Binding IngestFolderCommand}"
                            ToolTip.Tip="Read a folder of evidence and add its event logs, registry, Prefetch, shortcuts, browser history, mail, Recycle Bin and NTFS journal events to the timeline">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:CinderIcon Data="{x:Static c:Icons.Folder}" Width="14" Height="14" />
                            <TextBlock Text="Ingest folder…" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tb" Content="Stop" Command="{Binding IngestFolderCancelCommand}"
                            IsVisible="{Binding IsIngesting}"
                            ToolTip.Tip="Stop reading. Nothing from this folder is added." />
                    <Button Classes="tb icon" Command="{Binding RefreshCommand}"
                            ToolTip.Tip="Apply the dates and filters (Enter in a filter box does the same)">
                        <c:CinderIcon Data="{x:Static c:Icons.Swap}" Width="14" Height="14" />
                    </Button>
                    <TextBlock Text="Filters changed. Press Enter to apply." Classes="dim" FontSize="12"
                               VerticalAlignment="Center" Margin="4,0,0,0" IsVisible="{Binding FiltersEdited}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="tb" ToolTip.Tip="Flag the selected event as a finding in the open case">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:CinderIcon Data="{x:Static c:Icons.Bookmark}" Width="14" Height="14" />
                            <TextBlock Text="Bookmark" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="300" Spacing="10">
                                    <TextBlock Text="BOOKMARK SELECTED EVENT" Classes="section" />
                                    <TextBox Watermark="Note (optional)" Text="{Binding BookmarkNote}"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
                                    <Button Classes="accent" HorizontalAlignment="Right" Content="Add bookmark"
                                            Command="{Binding BookmarkSelectedCommand}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Classes="tb" ToolTip.Tip="Write every event matching the applied filter, not only the rows shown, in a format other timeline tools read">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:CinderIcon Data="{x:Static c:Icons.Download}" Width="14" Height="14" />
                            <TextBlock Text="Export" VerticalAlignment="Center" />
                            <c:CinderIcon Data="{x:Static c:Icons.ChevronDown}" Width="12" Height="12" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="Timesketch JSONL — best for large timelines" Command="{Binding ExportCommand}" CommandParameter="jsonl" />
                                <MenuItem Header="Timesketch CSV" Command="{Binding ExportCommand}" CommandParameter="csv" />
                                <MenuItem Header="Sleuth Kit bodyfile — mactime / Autopsy / Plaso" Command="{Binding ExportCommand}" CommandParameter="body" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Classes="ghost icon" ToolTip.Tip="More">
                        <TextBlock Text="⋯" FontSize="16" Margin="0,-4,0,0" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="Clear the timeline" Command="{Binding ClearCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Filters ===== -->
        <Border Grid.Row="1" Padding="14,8,14,10" Background="{DynamicResource CinderSurface1Brush}"
                BorderBrush="{DynamicResource CinderBorderBrush}" BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal">
                <WrapPanel.KeyBindings>
                    <KeyBinding Gesture="Return" Command="{Binding RefreshCommand}" />
                </WrapPanel.KeyBindings>
                <WrapPanel.Styles>
                    <Style Selector="WrapPanel > StackPanel">
                        <Setter Property="Margin" Value="0,2,14,2" />
                        <Setter Property="Spacing" Value="4" />
                    </Style>
                </WrapPanel.Styles>
                <StackPanel>
                    <TextBlock Text="FROM" Classes="section" />
                    <DatePicker SelectedDate="{Binding From, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="TO" Classes="section" />
                    <DatePicker SelectedDate="{Binding To, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="USER" Classes="section" />
                    <TextBox Text="{Binding UserFilter, UpdateSourceTrigger=PropertyChanged}" Watermark="any" Width="130" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="SOURCE" Classes="section" />
                    <TextBox Text="{Binding SourceFilter, UpdateSourceTrigger=PropertyChanged}" Watermark="evtx, browser…" Width="170"
                             ToolTip.Tip="Part of a source name. Separate several with commas: evtx, prefetch" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="CONTAINS" Classes="section" />
                    <TextBox Text="{Binding TextFilter, UpdateSourceTrigger=PropertyChanged}" Watermark="text in summary" Width="190" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="ATT&amp;CK" Classes="section" />
                    <AutoCompleteBox Text="{Binding MitreFilter}"
                                     ItemsSource="{Binding KnownMitreIds}"
                                     FilterMode="Contains"
                                     Watermark="T1078, TA0002…"
                                     Width="170"
                                     ToolTip.Tip="Technique or tactic id prefix. Events are auto-tagged on ingest from Windows event ids, Sysmon, PowerShell logging, Prefetch, UserAssist and Recycle Bin." />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ===== Histogram ===== -->
        <Border Grid.Row="2" Height="64" Padding="14,10,14,6" IsVisible="{Binding Events.Count}">
            <ItemsControl ItemsSource="{Binding Histogram}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Rectangle Margin="1,0" RadiusX="1" RadiusY="1"
                                   Fill="{DynamicResource CinderAccentDimBrush}"
                                   VerticalAlignment="Bottom" Height="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Always visible: progress while a folder is read, and "nothing matches" are both said here. -->
        <Border Grid.Row="3" Height="26" Padding="14,0"
                BorderBrush="{DynamicResource CinderBorderBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="{Binding StatusLine}" Classes="dim" FontSize="11.5" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusLine}" />
        </Border>

        <!-- ===== Events ===== -->
        <DataGrid Grid.Row="4" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}"
                  AutoGenerateColumns="False" IsReadOnly="True" IsVisible="{Binding Events.Count}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Timestamp (UTC)" Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="170"
                                    FontFamily="{DynamicResource CinderFontFamilyMono}" FontSize="12.5" />
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="150"
                                    FontFamily="{DynamicResource CinderFontFamilyMono}" FontSize="12.5" />
                <DataGridTextColumn Header="User" Binding="{Binding User}" Width="120" FontSize="12.5" />
                <DataGridTextColumn Header="ATT&amp;CK" Binding="{Binding TagsDisplay}" Width="110"
                                    FontFamily="{DynamicResource CinderFontFamilyMono}" FontSize="12.5" />
                <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*" FontSize="12.5" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- ===== Empty ===== -->
        <c:EmptyState Grid.Row="4" Icon="{x:Static c:Icons.Clock}" Title="No events yet"
                      Message="Ingest a folder of evidence: a triage collection, a mounted image, or an exported user profile. Cinder reads the timestamped records it finds there and lists them in time order."
                      IsVisible="{Binding ShowEmptyState}">
            <Button Classes="accent" HorizontalAlignment="Center" Height="30" Padding="14,0"
                    Content="Ingest folder…" Command="{Binding IngestFolderCommand}" />
        </c:EmptyState>

        <!-- Events exist, but the applied dates and filters match none of them. -->
        <c:EmptyState Grid.Row="4" Icon="{x:Static c:Icons.Clock}" Title="No events match"
                      Message="Nothing on the timeline falls inside these dates and filters. Widen the dates or clear a filter, then press Enter."
                      IsVisible="{Binding ShowNoMatches}" />
    </Grid>
</UserControl>
