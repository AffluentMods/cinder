<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tools="using:Cinder.App.ViewModels.Tools"
             x:Class="Cinder.App.Views.Tools.CloudView"
             x:DataType="tools:CloudPullTool">
    <ScrollViewer Padding="20" Background="{DynamicResource CinderBackground0Brush}">
        <StackPanel Spacing="14" MaxWidth="720">
            <Grid ColumnDefinitions="120,*">
                <TextBlock Grid.Column="0" Text="Provider" VerticalAlignment="Center"
                           Foreground="{DynamicResource CinderForegroundMutedBrush}" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider}" />
            </Grid>
            <Button Classes="accent" Content="Connect…" Command="{Binding ConnectCommand}"
                    HorizontalAlignment="Left" />
            <TextBlock Text="{Binding StatusLine}"
                       Foreground="{DynamicResource CinderForegroundMutedBrush}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding StatusLine, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
