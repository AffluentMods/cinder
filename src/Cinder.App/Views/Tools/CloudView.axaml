<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Cinder.App.Controls"
             xmlns:tools="using:Cinder.App.ViewModels.Tools"
             x:Class="Cinder.App.Views.Tools.CloudView"
             x:DataType="tools:CloudPullTool">
    <!-- Action form. This tool is unfinished, and says so before anything else. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" AllowAutoHide="True">
        <StackPanel Margin="28,24" MaxWidth="760" HorizontalAlignment="Left" Spacing="18">
            <Border Background="{DynamicResource CinderWarnSoftBrush}" BorderBrush="{DynamicResource CinderWarnBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,12">
                <Grid ColumnDefinitions="Auto,*">
                    <c:CinderIcon Data="{x:Static c:Icons.Alert}" Width="15" Height="15" VerticalAlignment="Top" Margin="0,1,10,0"
                                  Foreground="{DynamicResource CinderWarnBrush}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12.5" LineHeight="18"
                               Text="Not functional yet. Cinder can build the provider's sign-in link, but it cannot yet complete the sign-in or download anything. To collect cloud data today, use the provider's own export (Google Takeout, Microsoft Purview, Dropbox data export) and examine the result here." />
                </Grid>
            </Border>
            <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap" LineHeight="19" MaxWidth="640" HorizontalAlignment="Left"
                       Text="When it ships: sign in to the account with read-only access, list its files with their cloud hashes and activity history, and download selected files into the case with every request recorded in the custody log." />
            <Grid ColumnDefinitions="120,*">
                <TextBlock Text="Provider" Classes="label" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider}" MinWidth="180" />
            </Grid>
            <Border Background="{DynamicResource CinderSurface2Brush}" CornerRadius="8" Padding="14,12"
                    IsVisible="{Binding Instructions, Converter={x:Static ObjectConverters.IsNotNull}}">
                <SelectableTextBlock Text="{Binding Instructions}" TextWrapping="Wrap" FontSize="12.5" LineHeight="18" />
            </Border>
            <StackPanel Spacing="8" IsVisible="{Binding AuthorizeUrl, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="SIGN-IN LINK" Classes="section" />
                <Border Background="{DynamicResource CinderSurface2Brush}" CornerRadius="8" Padding="14,12">
                    <SelectableTextBlock Text="{Binding AuthorizeUrl}" Classes="mono" FontSize="12" TextWrapping="Wrap" />
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="tb" Height="30" Content="Copy link" Command="{Binding CopyAuthorizeUrlCommand}" />
                    <Button Classes="tb" Height="30" Content="Make a new link" Command="{Binding ConnectCommand}"
                            ToolTip.Tip="Each link can be used once. Make a new one if this one has expired." />
                </StackPanel>
            </StackPanel>
            <Border Background="{DynamicResource CinderSurface2Brush}" CornerRadius="8" Padding="14,12"
                    IsVisible="{Binding StatusLine, Converter={x:Static ObjectConverters.IsNotNull}}">
                <SelectableTextBlock Text="{Binding StatusLine}" TextWrapping="Wrap" FontSize="12.5" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
