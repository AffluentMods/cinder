<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tools="using:Cinder.App.ViewModels.Tools"
             xmlns:wf="using:Cinder.Workflow"
             x:Class="Cinder.App.Views.Tools.WorkflowsView"
             x:DataType="tools:WorkflowsTool">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="{DynamicResource CinderBackground1Brush}" Padding="14,10"
                BorderBrush="{DynamicResource CinderBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Classes="accent" Content="Open workflow .json…" Command="{Binding LoadCommand}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding Path, FallbackValue='No workflow loaded'}"
                           Foreground="{DynamicResource CinderForegroundMutedBrush}" />
                <TextBlock VerticalAlignment="Center" Margin="14,0"
                           Text="{Binding StatusLine}"
                           FontSize="{DynamicResource CinderFontSizeXs}"
                           Foreground="{DynamicResource CinderForegroundMutedBrush}" />
            </StackPanel>
        </Border>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Nodes}" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="{DynamicResource CinderBackground0Brush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"   Binding="{Binding Id}" Width="200" />
                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="200" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
