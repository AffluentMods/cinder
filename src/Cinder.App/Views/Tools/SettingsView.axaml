<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Cinder.App.Controls"
             xmlns:tools="using:Cinder.App.ViewModels.Tools"
             x:Class="Cinder.App.Views.Tools.SettingsView"
             x:DataType="tools:SettingsTool">
    <c:EmptyState Icon="{x:Static c:Icons.Cog}" Title="Settings"
                  Message="Theme, the hash-set database, the custody time-stamp service, the AI assistant's model, and cloud sign-in IDs.">
        <Button Classes="accent" Height="30" Padding="14,0" Content="Open settings…" ToolTip.Tip="Ctrl+,"
                Command="{Binding OpenSettingsCommand}" />
    </c:EmptyState>
</UserControl>
