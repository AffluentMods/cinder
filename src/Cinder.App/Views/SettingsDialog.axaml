<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cinder.App.ViewModels"
        x:Class="Cinder.App.Views.SettingsDialog"
        x:DataType="vm:SettingsDialogViewModel"
        Title="Cinder settings"
        Width="660" Height="680" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CinderSurface1Brush}"
        Foreground="{DynamicResource CinderForegroundBrush}"
        FontFamily="{DynamicResource CinderFontFamily}"
        FontSize="{DynamicResource CinderFontSizeBase}">
    <!-- Only settings that change something are shown. Options that were stored but never read
         (density, Vim keys, reduce motion, update check, Python paths) were removed from this
         dialog rather than left as switches that do nothing. -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="20,12" Background="{DynamicResource CinderSurface0Brush}"
                BorderBrush="{DynamicResource CinderBorderBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding SaveError}" Foreground="{DynamicResource CinderDangerBrush}" FontSize="12"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" IsVisible="{Binding HasSaveError}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="tb" Height="30" Padding="16,0" Content="Cancel" Click="OnCloseClick" />
                    <Button Classes="accent" Height="30" Padding="18,0" Content="Save" Click="OnSaveClick" IsDefault="True" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" AllowAutoHide="True">
            <StackPanel Margin="24,20" Spacing="26">

                <StackPanel Spacing="10">
                    <TextBlock Text="APPEARANCE" Classes="section" />
                    <Grid ColumnDefinitions="170,*">
                        <TextBlock Text="Theme" Classes="label" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}" MinWidth="180" />
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Text="HASH SETS" Classes="section" />
                    <TextBlock Classes="muted" FontSize="12" LineHeight="17" TextWrapping="Wrap"
                               Text="The hash-set database used by the Hash sets tool. With hashing switched on, the Filesystem tool also hashes every file it lists and marks each one Known, Notable or Unknown, so you can filter out standard operating-system files. Hashing a whole volume is slow; it is off by default." />
                    <Grid ColumnDefinitions="170,*">
                        <TextBlock Text="Database" Classes="label" />
                        <TextBox Grid.Column="1" Text="{Binding HashSetDatabase}" Watermark="Choose it in the Hash sets tool"
                                 FontFamily="{DynamicResource CinderFontFamilyMono}" />
                    </Grid>
                    <Grid ColumnDefinitions="170,*">
                        <TextBlock Text="Skip files larger than" Classes="label" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <NumericUpDown Value="{Binding HashSizeLimitMb}" Minimum="1" Maximum="4096" Increment="16" FormatString="0" Width="150" />
                            <TextBlock Text="MB" Classes="label" />
                        </StackPanel>
                    </Grid>
                    <CheckBox Margin="170,0,0,0" IsChecked="{Binding HashFilesOnEnumerate}"
                              Content="Hash files while listing a file system" />
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Text="CHAIN OF CUSTODY" Classes="section" />
                    <TextBlock Classes="muted" FontSize="12" LineHeight="17" TextWrapping="Wrap"
                               Text="Optional. When an address is set, signing a custody log also asks this time-stamp service (RFC 3161) to countersign, so the time comes from a clock you do not control. Only a hash of your signature is sent, never case content. Public services include freetsa.org, DigiCert and Sectigo; an organisation can run its own." />
                    <Grid ColumnDefinitions="170,*">
                        <TextBlock Text="Time-stamp service" Classes="label" />
                        <TextBox Grid.Column="1" Text="{Binding TimestampAuthorityUrl}" Watermark="https://freetsa.org/tsr   (leave empty to turn off)"
                                 FontFamily="{DynamicResource CinderFontFamilyMono}" />
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Text="AI ASSISTANT" Classes="section" />
                    <TextBlock Classes="muted" FontSize="12" LineHeight="17" TextWrapping="Wrap"
                               Text="The model the AI assistant tool starts with. Cinder ships no model: point it at one running on this computer (Ollama, LM Studio) or at a hosted service. Anything typed into the assistant is sent to that address." />
                    <Grid ColumnDefinitions="170,*">
                        <TextBlock Text="Where the model runs" Classes="label" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding AiProviderOptions}" SelectedItem="{Binding AiProviderId}" MinWidth="180" />
                    </Grid>
                    <Grid ColumnDefinitions="170,*">
                        <TextBlock Text="Address" Classes="label" />
                        <TextBox Grid.Column="1" Text="{Binding AiEndpoint}" Watermark="http://localhost:11434"
                                 FontFamily="{DynamicResource CinderFontFamilyMono}" />
                    </Grid>
                    <Grid ColumnDefinitions="170,*">
                        <TextBlock Text="Model name" Classes="label" />
                        <TextBox Grid.Column="1" Text="{Binding AiModel}" Watermark="llama3"
                                 FontFamily="{DynamicResource CinderFontFamilyMono}" />
                    </Grid>
                    <Grid ColumnDefinitions="170,*">
                        <TextBlock Text="API key" Classes="label" />
                        <TextBox Grid.Column="1" Text="{Binding AiApiKey}" PasswordChar="•" Watermark="Only for a hosted service" />
                    </Grid>
                    <TextBlock Margin="170,0,0,0" Classes="dim" FontSize="11.5" TextWrapping="Wrap"
                               Text="The key is stored in your settings file on this computer, in plain text." />
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Text="CLOUD SIGN-IN" Classes="section" />
                    <TextBlock Classes="muted" FontSize="12" LineHeight="17" TextWrapping="Wrap"
                               Text="Used by the Cloud pull tool, which is not finished yet. Each value is the public client ID of a sign-in application you create in the provider's developer console (docs/cloud-setup.md explains how). Never paste a client secret here." />
                    <Grid ColumnDefinitions="170,*">
                        <TextBlock Text="Google Drive" Classes="label" />
                        <TextBox Grid.Column="1" Text="{Binding GoogleDriveClientId}" Watermark="123-abc.apps.googleusercontent.com"
                                 FontFamily="{DynamicResource CinderFontFamilyMono}" />
                    </Grid>
                    <Grid ColumnDefinitions="170,*">
                        <TextBlock Text="OneDrive" Classes="label" />
                        <TextBox Grid.Column="1" Text="{Binding OneDriveClientId}" Watermark="00000000-0000-0000-0000-000000000000"
                                 FontFamily="{DynamicResource CinderFontFamilyMono}" />
                    </Grid>
                    <Grid ColumnDefinitions="170,*">
                        <TextBlock Text="Dropbox" Classes="label" />
                        <TextBox Grid.Column="1" Text="{Binding DropboxAppKey}" Watermark="Dropbox app key"
                                 FontFamily="{DynamicResource CinderFontFamilyMono}" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
