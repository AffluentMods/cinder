<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cinder.App.ViewModels"
             xmlns:svc="using:Cinder.App.Services"
             xmlns:c="using:Cinder.App.Controls"
             x:Class="Cinder.App.Views.CommandPaletteView"
             x:DataType="vm:CommandPaletteViewModel">

    <!-- Click outside the panel to dismiss. -->
    <Panel>
        <Border x:Name="Backdrop" Background="#99000000" PointerPressed="OnBackdropPressed" />

        <Border x:Name="Panel"
                Width="660" MaxHeight="460"
                VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,96,0,0"
                Background="{DynamicResource CinderSurface2Brush}"
                BorderBrush="{DynamicResource CinderBorderStrongBrush}" BorderThickness="1"
                CornerRadius="10"
                BoxShadow="0 24 48 0 #99000000"
                RenderTransformOrigin="50%,0%">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
                </Transitions>
            </Border.Transitions>
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="48" Padding="16,0,12,0"
                        BorderBrush="{DynamicResource CinderBorderBrush}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <c:CinderIcon Data="{x:Static c:Icons.Search}" Width="16" Height="16"
                                      Foreground="{DynamicResource CinderForegroundDisabledBrush}" />
                        <TextBox Grid.Column="1" x:Name="QueryBox" Classes="bare" Margin="12,0" FontSize="14"
                                 Watermark="Type a command or a tool name…" Text="{Binding Query}">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Down" Command="{Binding MoveCommand}" CommandParameter="1" />
                                <KeyBinding Gesture="Up" Command="{Binding MoveCommand}" CommandParameter="-1" />
                                <KeyBinding Gesture="Enter" Command="{Binding InvokeSelectedCommand}" />
                                <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Border Grid.Column="2" Classes="kbd"><TextBlock Text="Esc" /></Border>
                    </Grid>
                </Border>

                <Border DockPanel.Dock="Bottom" Height="30" Padding="16,0"
                        BorderBrush="{DynamicResource CinderBorderBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Classes="kbd"><TextBlock Text="↑↓" /></Border>
                            <TextBlock Text="move" Classes="legend" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Classes="kbd"><TextBlock Text="Enter" /></Border>
                            <TextBlock Text="run" Classes="legend" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Classes="kbd"><TextBlock Text="Esc" /></Border>
                            <TextBlock Text="close" Classes="legend" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Panel>
                    <TextBlock Text="No matching commands." Classes="dim" Margin="16,14" IsVisible="{Binding HasNoResults}" />
                    <ListBox x:Name="List" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}"
                             Padding="6" Background="Transparent">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="10,0" />
                                <Setter Property="MinHeight" Value="38" />
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource CinderSurface3Brush}" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="svc:CommandDescriptor">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" Background="Transparent"
                                      DoubleTapped="OnItemActivated" Tapped="OnItemActivated">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Subtitle}" Classes="dim" FontSize="12" VerticalAlignment="Center"
                                                   MaxWidth="330" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding Category}" Classes="dim" FontSize="11.5" VerticalAlignment="Center" />
                                        <Border Classes="kbd" IsVisible="{Binding HasShortcut}"><TextBlock Text="{Binding Shortcut}" /></Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Panel>
            </DockPanel>
        </Border>
    </Panel>
</UserControl>
